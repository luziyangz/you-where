.partner-page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  padding: 80rpx 34rpx 72rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 86% 4%, rgba(92, 143, 117, 0.14), transparent 220rpx),
    linear-gradient(180deg, #fbf6ec 0%, #f3eadb 100%);
}

.page-noise {
  position: absolute;
  left: -140rpx;
  bottom: 120rpx;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  background: rgba(184, 92, 56, 0.1);
  pointer-events: none;
}

.page-head,
.stage-card,
.bind-card,
.invite-card,
.share-card,
.relationship-card,
.relation-summary,
.next-card,
.stats-strip,
.compact-share,
.danger-link {
  position: relative;
  z-index: 1;
}

.eyebrow {
  display: inline-flex;
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(184, 92, 56, 0.24);
  border-radius: 999rpx;
  background: rgba(255, 251, 243, 0.72);
  color: #a54f33;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.page-title {
  margin-top: 22rpx;
  color: #2d2822;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.14;
}

.page-desc {
  margin-top: 18rpx;
  color: #7c7164;
  font-size: 27rpx;
  line-height: 1.7;
}

.bind-card,
.invite-card,
.stage-card,
.share-card,
.relationship-card,
.next-card,
.stats-strip,
.compact-share {
  margin-top: 34rpx;
  padding: 34rpx;
  border: 1rpx solid rgba(120, 98, 72, 0.16);
  border-radius: 40rpx;
  background: rgba(255, 251, 243, 0.88);
  box-shadow: 0 20rpx 54rpx rgba(69, 47, 26, 0.09);
  box-sizing: border-box;
}

.field-label,
.share-label,
.card-kicker,
.next-label,
.compact-label {
  color: #a54f33;
  font-size: 23rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.stage-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 34rpx 26rpx;
}

.stage-person {
  width: 162rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stage-avatar {
  width: 112rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 8rpx solid rgba(255, 251, 243, 0.92);
  border-radius: 50%;
  background: #b85c38;
  color: #fff8ed;
  font-size: 34rpx;
  font-weight: 900;
  box-shadow: 0 12rpx 28rpx rgba(69, 47, 26, 0.12);
}

.stage-person.me .stage-avatar {
  background: #5c8f75;
}

.stage-avatar.empty {
  border: 2rpx dashed rgba(124, 113, 100, 0.34);
  background: rgba(124, 113, 100, 0.08);
  color: #8a7d6e;
  box-shadow: none;
}

.stage-avatar image {
  width: 100%;
  height: 100%;
  display: block;
}

.stage-name {
  margin-top: 14rpx;
  max-width: 160rpx;
  color: #2d2822;
  font-size: 24rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stage-name.muted {
  color: #8a7d6e;
}

.stage-thread {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 10rpx;
}

.thread-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(124, 113, 100, 0.22);
}

.thread-dot.active {
  background: #5c8f75;
}

.thread-line {
  flex: 1;
  height: 4rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #5c8f75, rgba(124, 113, 100, 0.18));
}

.card-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.card-title {
  margin-top: 10rpx;
  color: #2d2822;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.34;
}

.code-ticket {
  position: relative;
  margin-top: 26rpx;
  padding: 30rpx 20rpx;
  border: 1rpx dashed rgba(184, 92, 56, 0.28);
  border-radius: 34rpx;
  background:
    linear-gradient(90deg, rgba(184, 92, 56, 0.08), rgba(92, 143, 117, 0.08)),
    #fff8ed;
  text-align: center;
}

.code-ticket text {
  color: #4f7b65;
  font-size: 66rpx;
  font-weight: 900;
  letter-spacing: 10rpx;
  line-height: 1;
}

.ticket-hint {
  margin-top: 18rpx;
  color: #7c7164;
  font-size: 25rpx;
  line-height: 1.6;
}

.invite-row {
  display: flex;
  align-items: stretch;
  margin-top: 18rpx;
  overflow: hidden;
  border: 1rpx solid rgba(120, 98, 72, 0.14);
  border-radius: 30rpx;
  background: #fbf7ef;
}

.invite-input {
  flex: 1;
  min-height: 112rpx;
  padding: 28rpx 28rpx;
  color: #2d2822;
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  line-height: 48rpx;
  box-sizing: border-box;
}

.bind-btn {
  width: 170rpx;
  min-height: 112rpx;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: #5c8f75;
  color: #fff8ed;
  font-size: 30rpx;
  font-weight: 900;
  line-height: normal;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bind-btn::after,
.scan-btn::after,
.danger-link::after {
  border: none;
}

.scan-btn {
  width: 100%;
  height: 92rpx;
  margin-top: 22rpx;
  border: 1rpx solid rgba(92, 143, 117, 0.24);
  border-radius: 30rpx;
  background: rgba(92, 143, 117, 0.1);
  color: #4f7b65;
  font-size: 28rpx;
  font-weight: 900;
  line-height: normal;
  display: flex;
  align-items: center;
  justify-content: center;
}

.compact-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.share-value,
.compact-code {
  margin-top: 8rpx;
  color: #4f7b65;
  font-size: 56rpx;
  font-weight: 900;
  letter-spacing: 6rpx;
  line-height: 1;
}

.copy-icon {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1rpx solid rgba(120, 98, 72, 0.18);
  border-radius: 18rpx;
  background: #fff8ed;
  color: #7c7164;
  font-size: 26rpx;
  font-weight: 900;
}

.share-hint {
  margin-top: 18rpx;
  color: #7c7164;
  font-size: 25rpx;
  line-height: 1.6;
}

.qr-zone {
  margin-top: 26rpx;
  padding-top: 26rpx;
  border-top: 1rpx dashed rgba(120, 98, 72, 0.18);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qr-frame {
  padding: 18rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 28rpx rgba(69, 47, 26, 0.08);
}

.my-qr-canvas {
  width: 128px;
  height: 128px;
  display: block;
  border-radius: 14rpx;
  background: #fff;
}

.qr-actions,
.qr-mini-actions {
  display: flex;
  justify-content: center;
  gap: 34rpx;
  margin-top: 18rpx;
  color: #7c7164;
  font-size: 24rpx;
  font-weight: 800;
}

.relationship-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.person {
  width: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  width: 116rpx;
  height: 116rpx;
  border: 8rpx solid rgba(255, 251, 243, 0.92);
  border-radius: 50%;
  box-shadow: 0 12rpx 28rpx rgba(69, 47, 26, 0.12);
}

.avatar-text {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff8ed;
  font-size: 36rpx;
  font-weight: 900;
}

.avatar.me {
  background: #5c8f75;
}

.avatar.partner {
  background: #b85c38;
}

.person-name {
  max-width: 160rpx;
  margin-top: 14rpx;
  color: #2d2822;
  font-size: 24rpx;
  font-weight: 900;
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.relation-line {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 8rpx;
}

.line-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #b85c38;
}

.line-body {
  flex: 1;
  height: 4rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #5c8f75, #b85c38);
}

.relation-summary {
  margin-top: 28rpx;
  text-align: center;
}

.summary-main {
  color: #2d2822;
}

.summary-num {
  font-size: 86rpx;
  font-weight: 900;
  line-height: 1;
}

.summary-unit,
.summary-text {
  color: #7c7164;
  font-size: 26rpx;
  font-weight: 800;
}

.next-title {
  margin-top: 10rpx;
  color: #2d2822;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.35;
}

.next-desc {
  margin: 12rpx 0 28rpx;
  color: #7c7164;
  font-size: 26rpx;
  line-height: 1.65;
}

.next-card .btn-secondary {
  margin-top: 16rpx;
}

.stats-strip {
  display: flex;
  justify-content: space-around;
  padding: 28rpx 20rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  color: #2d2822;
  font-size: 42rpx;
  font-weight: 900;
}

.stat-label {
  margin-top: 8rpx;
  color: #7c7164;
  font-size: 23rpx;
  font-weight: 800;
}

.compact-share {
  padding: 28rpx 30rpx;
}

.compact-code {
  font-size: 40rpx;
  letter-spacing: 4rpx;
}

.qr-hidden {
  position: fixed;
  left: -9999px;
  top: -9999px;
}

.request-card {
  margin-top: 24rpx;
  padding: 28rpx 30rpx;
  border-radius: 28rpx;
  background: rgba(255, 251, 243, 0.92);
  border: 1rpx solid rgba(184, 92, 56, 0.2);
  box-sizing: border-box;
}

.request-card--out {
  border-color: rgba(92, 143, 117, 0.25);
}

.request-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #2d2822;
}

.request-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7c7164;
  line-height: 1.5;
}

.request-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.request-btn {
  flex: 1;
  margin: 0;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.request-btn.reject {
  background: rgba(255, 251, 243, 0.9);
  color: #8a7d6e;
  border: 1rpx solid rgba(120, 98, 72, 0.18);
}

.request-btn.approve {
  background: linear-gradient(135deg, #5c8f75, #477560);
  color: #fff8ed;
}

.request-btn::after {
  border: none;
}

.danger-link {
  width: 100%;
  margin-top: 30rpx;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: #a75b4a;
  font-size: 26rpx;
  font-weight: 800;
  line-height: normal;
}

.danger-link--force {
  margin-top: 12rpx;
  color: #8b4d30;
}
