<view class="partner-page">
  <view class="page-noise"></view>

  <block wx:if="{{!hasPartner}}">
    <view class="page-head">
      <view class="eyebrow">结伴邀请</view>
      <view class="page-title">先把两个人放进同一间书房</view>
      <view class="page-desc">结伴页只处理连接。绑定完成后，首页负责共读状态，日记页负责记录和回应。</view>
    </view>

    <view class="stage-card">
      <view class="stage-person me">
        <view class="stage-avatar">
          <block wx:if="{{myAvatar}}">
            <image src="{{myAvatar}}" mode="aspectFill"></image>
          </block>
          <block wx:else>{{myNickname ? myNickname[0] : '我'}}</block>
        </view>
        <view class="stage-name">{{myNickname || '我'}}</view>
      </view>
      <view class="stage-thread">
        <view class="thread-dot active"></view>
        <view class="thread-line"></view>
        <view class="thread-dot"></view>
      </view>
      <view class="stage-person">
        <view class="stage-avatar empty">TA</view>
        <view class="stage-name muted">等待加入</view>
      </view>
    </view>

    <view class="invite-card" wx:if="{{myNickname}}">
      <view class="card-heading">
        <view>
          <view class="card-kicker">让对方绑定我</view>
          <view class="card-title">使用这组共读码完成绑定</view>
        </view>
        <view class="copy-icon" bindtap="onCopyMyJoinCode">⧉</view>
      </view>
      <view class="code-ticket" bindtap="onCopyMyJoinCode">
        <text>{{myJoinCode}}</text>
      </view>
      <view class="ticket-hint">对方输入这 6 位数字，或直接扫描下方二维码。</view>
      <view class="qr-zone" wx:if="{{myBindQrText}}">
        <view class="qr-frame">
          <canvas canvas-id="myBindQrCanvas" class="my-qr-canvas" bindtap="onPreviewMyQr"></canvas>
        </view>
        <view class="qr-actions">
          <text bindtap="onPreviewMyQr">预览</text>
          <text bindtap="onSaveMyQr">保存</text>
        </view>
      </view>
    </view>

    <view class="request-card" wx:if="{{pairRequestIncoming}}">
      <view class="request-title">{{pairRequestTitle}}</view>
      <view class="request-sub">{{pairRequestSub}}</view>
      <view class="request-actions">
        <button class="request-btn reject" loading="{{pairRequestResponding}}" bindtap="onRejectPairRequest">拒绝</button>
        <button class="request-btn approve" loading="{{pairRequestResponding}}" bindtap="onApprovePairRequest">同意</button>
      </view>
    </view>
    <view class="request-card request-card--out" wx:elif="{{pairRequestOutgoing}}">
      <view class="request-title">{{pairRequestTitle}}</view>
      <view class="request-sub">{{pairRequestSub}}</view>
    </view>

    <view class="bind-card">
      <view class="card-kicker">我收到对方共读码</view>
      <view class="card-title">输入 TA 的 6 位数字</view>
      <view class="invite-row">
        <input
          class="invite-input"
          placeholder="000000"
          value="{{inviteCode}}"
          bindinput="onInputInviteCode"
          maxlength="6"
          type="number"
        />
        <button class="bind-btn" loading="{{bindLoading}}" bindtap="bindPartner">绑定</button>
      </view>
      <button class="scan-btn" bindtap="scanToBind">扫一扫绑定</button>
    </view>
  </block>

  <block wx:else>
    <view class="page-head bound-head">
      <view class="eyebrow">共读关系</view>
      <view class="page-title">你们已经在同一间书房</view>
      <view class="page-desc">这里管理关系本身。要选书去书房，要记录和回应去日记。</view>
    </view>

    <view class="relationship-card">
      <view class="person">
        <block wx:if="{{myAvatar}}">
          <image class="avatar me" src="{{myAvatar}}" mode="aspectFill"></image>
        </block>
        <block wx:else>
          <view class="avatar avatar-text me">{{myNickname ? myNickname[0] : '我'}}</view>
        </block>
        <view class="person-name">{{myNickname || '我'}}</view>
      </view>
      <view class="relation-line">
        <view class="line-dot"></view>
        <view class="line-body"></view>
        <view class="line-dot"></view>
      </view>
      <view class="person">
        <block wx:if="{{partnerAvatar}}">
          <image class="avatar partner" src="{{partnerAvatar}}" mode="aspectFill"></image>
        </block>
        <block wx:else>
          <view class="avatar avatar-text partner">{{partnerNickname ? partnerNickname[0] : '伴'}}</view>
        </block>
        <view class="person-name">{{partnerNickname || '对方'}}</view>
      </view>
    </view>

    <view class="relation-summary">
      <view class="summary-main">
        <text class="summary-num">{{bindDays}}</text>
        <text class="summary-unit">天</text>
      </view>
      <view class="summary-text">已经结伴共读</view>
    </view>

    <view class="request-card" wx:if="{{pairRequestIncoming}}">
      <view class="request-title">{{pairRequestTitle}}</view>
      <view class="request-sub">{{pairRequestSub}}</view>
      <view class="request-actions">
        <button class="request-btn reject" loading="{{pairRequestResponding}}" bindtap="onRejectPairRequest">拒绝</button>
        <button class="request-btn approve" loading="{{pairRequestResponding}}" bindtap="onApprovePairRequest">同意</button>
      </view>
    </view>
    <view class="request-card request-card--out" wx:elif="{{pairRequestOutgoing}}">
      <view class="request-title">{{pairRequestTitle}}</view>
      <view class="request-sub">{{pairRequestSub}}</view>
    </view>

    <view class="next-card">
      <block wx:if="{{currentBook}}">
        <view class="next-label">当前共读</view>
        <view class="next-title">{{currentBook.title}}</view>
        <view class="next-desc">去记录页更新今天读到哪里，或查看对方最近同步的进度备注。</view>
        <button class="btn-primary w-full" bindtap="onGoProgress">去共读日记</button>
      </block>
      <block wx:else>
        <view class="next-label">下一步</view>
        <view class="next-title">还没有共同开始一本书</view>
        <view class="next-desc">去主题书房选一本适合两个人慢慢读的书。</view>
        <button class="btn-primary w-full" bindtap="onGoBookstore">去主题书房</button>
      </block>
      <button class="btn-secondary w-full" bindtap="onGoHome">回到共读首页</button>
    </view>

    <view class="stats-strip">
      <view class="stat-item">
        <view class="stat-num">{{sharedBooks}}</view>
        <view class="stat-label">共同读过</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{sharedNotes}}</view>
        <view class="stat-label">进度记录</view>
      </view>
    </view>

    <view class="compact-share" wx:if="{{myNickname}}">
      <view class="compact-row">
        <view>
          <view class="compact-label">我的共读码</view>
          <view class="compact-code">{{myJoinCode}}</view>
        </view>
        <view class="copy-icon" bindtap="onCopyMyJoinCode">⧉</view>
      </view>
      <view class="qr-mini-actions" wx:if="{{myBindQrText}}">
        <text bindtap="onPreviewMyQr">预览二维码</text>
        <text bindtap="onSaveMyQr">保存二维码</text>
      </view>
      <canvas canvas-id="myBindQrCanvas" class="my-qr-canvas qr-hidden"></canvas>
    </view>

    <button class="danger-link" loading="{{unbindLoading}}" bindtap="unbindPartner">申请解除结伴</button>
    <button wx:if="{{canForceUnbind}}" class="danger-link danger-link--force" loading="{{unbindLoading}}" bindtap="onForceUnbindPartner">强制解除（满 7 天）</button>
  </block>
</view>
