.book-detail-page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  padding: 72rpx 28rpx 70rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 88% 4%, rgba(92, 143, 117, 0.14), transparent 220rpx),
    linear-gradient(180deg, #fbf6ec 0%, #f3eadb 100%);
}

.page-orb {
  position: absolute;
  left: -150rpx;
  top: 260rpx;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  background: rgba(184, 92, 56, 0.1);
  pointer-events: none;
}

.book-card {
  position: relative;
  z-index: 1;
  padding: 34rpx;
  border: 1rpx solid rgba(120, 98, 72, 0.16);
  border-radius: 40rpx;
  background: rgba(255, 251, 243, 0.9);
  box-shadow: 0 20rpx 54rpx rgba(69, 47, 26, 0.08);
  box-sizing: border-box;
}

.skeleton-card .sk-line {
  height: 28rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #ebe4d8 0%, #f5f0e6 50%, #ebe4d8 100%);
  background-size: 200% 100%;
  animation: sk-shimmer 1.2s ease-in-out infinite;
  margin-bottom: 20rpx;
}

.skeleton-card .sk-title {
  width: 65%;
  height: 40rpx;
}

.skeleton-card .sk-sub {
  width: 45%;
}

.skeleton-card .sk-body {
  width: 100%;
}

.skeleton-card .sk-body.short {
  width: 80%;
}

.skeleton-card .sk-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 36rpx;
}

.skeleton-card .sk-btn {
  flex: 1;
  height: 100rpx;
  border-radius: 28rpx;
  background: #ebe4d8;
}

@keyframes sk-shimmer {
  0% {
    background-position: 100% 0;
  }
  100% {
    background-position: -100% 0;
  }
}

.retry-btn {
  margin-top: 28rpx;
  background: linear-gradient(135deg, #5c8f75, #477560);
  color: #fff8ed;
  font-weight: 900;
  border-radius: 28rpx;
}

.retry-btn::after {
  border: none;
}

.resume-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 22rpx;
  padding: 22rpx 26rpx;
  border-radius: 28rpx;
  background: rgba(92, 143, 117, 0.12);
  border: 1rpx solid rgba(92, 143, 117, 0.22);
}

.resume-text {
  font-size: 26rpx;
  color: #4f7b65;
  font-weight: 700;
}

.resume-link {
  font-size: 26rpx;
  color: #b85c38;
  font-weight: 900;
}

.toc-section {
  margin-top: 22rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(120, 98, 72, 0.14);
  background: rgba(255, 251, 243, 0.65);
  overflow: hidden;
}

.toc-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
}

.toc-bar-title {
  margin: 0;
}

.toc-chevron {
  font-size: 24rpx;
  font-weight: 800;
  color: #b85c38;
}

.toc-body {
  padding: 0 24rpx 22rpx;
  border-top: 1rpx solid rgba(120, 98, 72, 0.1);
}

.toc-hint {
  padding: 18rpx 0 8rpx;
  font-size: 24rpx;
  color: #8a7d6e;
  line-height: 1.5;
}

.toc-list {
  max-height: 420rpx;
  overflow-y: auto;
  padding-top: 12rpx;
}

.toc-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(120, 98, 72, 0.08);
}

.toc-row:last-of-type {
  border-bottom: none;
}

.toc-row-title {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 700;
  color: #2d2822;
  line-height: 1.35;
}

.toc-row-page {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 800;
  color: #6e6255;
}

.toc-footnote {
  padding: 14rpx 0 4rpx;
  font-size: 21rpx;
  color: #a89888;
  line-height: 1.45;
}

.book-head {
  display: flex;
  gap: 28rpx;
}

.cover {
  width: 180rpx;
  height: 252rpx;
  flex-shrink: 0;
  overflow: hidden;
  border-radius: 24rpx 12rpx 12rpx 24rpx;
  background: linear-gradient(160deg, #8f4d35, #c98a5a);
  box-shadow: 14rpx 18rpx 32rpx rgba(69, 47, 26, 0.16);
}

.cover-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22rpx;
  box-sizing: border-box;
}

.cover-fallback text {
  color: #fff8ed;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.35;
}

.meta {
  flex: 1;
  min-width: 0;
}

.meta-head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.category-pill {
  display: inline-flex;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(92, 143, 117, 0.14);
  color: #4f7b65;
  font-size: 22rpx;
  font-weight: 900;
}

.category-pill--ghost {
  opacity: 0.65;
}

.fav-chip {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(184, 92, 56, 0.12);
  border: 1rpx solid rgba(184, 92, 56, 0.2);
}

.fav-chip--busy {
  opacity: 0.55;
  pointer-events: none;
}

.fav-star {
  font-size: 30rpx;
  line-height: 1;
  color: #c9885e;
}

.fav-label {
  font-size: 22rpx;
  font-weight: 900;
  color: #8b4d30;
}

.title {
  margin-top: 14rpx;
  color: #2d2822;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.25;
}

.author {
  margin-top: 12rpx;
  color: #6e6255;
  font-size: 26rpx;
  font-weight: 800;
}

.desc {
  margin-top: 10rpx;
  color: #8a7d6e;
  font-size: 24rpx;
  line-height: 1.55;
}

.action-panel {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  margin-top: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.secondary-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.link-action,
.share-action {
  margin: 0;
  padding: 0 24rpx;
  min-height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  background: #f3eadb;
  color: #5c5348;
  font-size: 24rpx;
}

.share-action {
  background: #e8f3ec;
  color: #3d6b52;
}

.link-action::after,
.share-action::after {
  border: none;
}

.read-action--external {
  background: linear-gradient(135deg, #c9885e, #b85c38) !important;
}

.read-action--disabled {
  opacity: 0.55;
}

.read-action,
.pair-action {
  flex: 1 1 0;
  min-width: 0;
  max-width: calc((100% - 12rpx) / 2);
  min-height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 12rpx 10rpx;
  border-radius: 28rpx;
  text-align: center;
  box-sizing: border-box;
  width: 100%;
  overflow: hidden;
}

.read-action::after,
.pair-action::after {
  border: none;
}

.read-action {
  border: 1rpx solid rgba(120, 98, 72, 0.16);
  background: rgba(255, 248, 237, 0.86);
  color: #2d2822;
}

.pair-action {
  background: linear-gradient(135deg, #5c8f75, #477560);
  color: #fff8ed;
  box-shadow: 0 16rpx 34rpx rgba(92, 143, 117, 0.22);
}

.pair-action--muted {
  background: rgba(120, 98, 72, 0.12);
  color: #6a5c4a;
  box-shadow: none;
}

.action-main {
  max-width: 100%;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pair-action .action-main {
  font-size: 28rpx;
}

.action-sub {
  max-width: 100%;
  margin-top: 7rpx;
  font-size: 20rpx;
  font-weight: 800;
  opacity: 0.72;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.intro,
.reviews {
  margin-top: 32rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid rgba(120, 98, 72, 0.12);
}

.section-title {
  margin-bottom: 16rpx;
  color: #2d2822;
  font-size: 28rpx;
  font-weight: 900;
}

.intro-text {
  color: #6e6255;
  font-size: 25rpx;
  line-height: 1.75;
}

.review-item {
  margin-bottom: 16rpx;
  padding: 22rpx;
  border-radius: 26rpx;
  background: rgba(92, 143, 117, 0.08);
}

.review-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 10rpx;
}

.reviewer {
  color: #4f7b65;
  font-size: 24rpx;
  font-weight: 900;
}

.rating {
  color: #b85c38;
  font-size: 22rpx;
  font-weight: 900;
}

.review-content {
  color: #5d5348;
  font-size: 24rpx;
  line-height: 1.65;
}
