.journal-page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  padding: 80rpx 34rpx 240rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 10% 8%, rgba(184, 92, 56, 0.12), transparent 230rpx),
    linear-gradient(180deg, #fbf6ec 0%, #f3eadb 100%);
}

.page-bg {
  position: absolute;
  right: -180rpx;
  top: 220rpx;
  width: 520rpx;
  height: 520rpx;
  border-radius: 50%;
  background: rgba(92, 143, 117, 0.1);
  pointer-events: none;
}

.empty-state,
.page-head,
.progress-card,
.relation-strip,
.action-card,
.section-header,
.notes-stream {
  position: relative;
  z-index: 1;
}

.empty-state {
  min-height: calc(100vh - 220rpx);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.eyebrow {
  display: inline-flex;
  align-self: flex-start;
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(184, 92, 56, 0.24);
  border-radius: 999rpx;
  background: rgba(255, 251, 243, 0.72);
  color: #a54f33;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.page-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 22rpx;
}

.page-head:active {
  opacity: 0.92;
}

.page-head-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #4f7b65;
}

.page-title,
.empty-title {
  margin-top: 22rpx;
  color: #2d2822;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.16;
}

.empty-title {
  font-size: 52rpx;
}

.page-desc,
.empty-desc {
  margin-top: 16rpx;
  color: #7c7164;
  font-size: 27rpx;
  line-height: 1.7;
}

.empty-desc {
  margin-bottom: 34rpx;
}

.book-seal {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
  background: #b85c38;
  color: #fff8ed;
  font-size: 24rpx;
  font-weight: 900;
  box-shadow: inset 0 0 0 6rpx rgba(255, 248, 237, 0.22);
}

.relation-strip,
.action-card,
.note-card {
  margin-top: 34rpx;
  padding: 34rpx;
  border: 1rpx solid rgba(120, 98, 72, 0.16);
  border-radius: 40rpx;
  background: rgba(255, 251, 243, 0.88);
  box-shadow: 0 20rpx 54rpx rgba(69, 47, 26, 0.08);
  box-sizing: border-box;
}

.relation-strip-main {
  color: #2d2822;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.45;
}

.relation-strip-meta {
  margin-top: 10rpx;
  color: #7c7164;
  font-size: 24rpx;
  font-weight: 700;
}

.relation-duo {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.relation-person {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  color: #2d2822;
  font-size: 24rpx;
  font-weight: 900;
}

.relation-bridge {
  width: 48rpx;
  height: 2rpx;
  flex-shrink: 0;
  background: linear-gradient(90deg, #5c8f75, #b85c38);
}

.circle-entry {
  margin-top: 24rpx;
  padding: 28rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border: 1rpx solid rgba(184, 92, 56, 0.18);
  border-radius: 32rpx;
  background: linear-gradient(135deg, rgba(255, 251, 243, 0.95), rgba(239, 226, 207, 0.72));
  box-shadow: 0 14rpx 36rpx rgba(69, 47, 26, 0.06);
}

.circle-entry:active {
  opacity: 0.92;
}

.circle-entry-badge {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(184, 92, 56, 0.12);
  color: #a54f33;
  font-size: 22rpx;
  font-weight: 900;
  flex-shrink: 0;
}

.circle-entry-body {
  flex: 1;
  min-width: 0;
}

.circle-entry-title {
  color: #2d2822;
  font-size: 28rpx;
  font-weight: 900;
}

.circle-entry-desc {
  margin-top: 6rpx;
  color: #7c7164;
  font-size: 23rpx;
  line-height: 1.5;
}

.circle-entry-arrow {
  color: #a54f33;
  font-size: 40rpx;
  font-weight: 300;
  line-height: 1;
}

.share-preview {
  margin-bottom: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(92, 143, 117, 0.08);
}

.share-preview-label {
  display: block;
  color: #4f7b65;
  font-size: 22rpx;
  font-weight: 900;
}

.share-preview-book {
  display: block;
  margin-top: 8rpx;
  color: #2d2822;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.45;
}

.finish-row.compact {
  margin-top: 22rpx;
  gap: 16rpx;
}

.progress-card-top,
.progress-row,
.section-header,
.note-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-label {
  color: #a54f33;
  font-size: 23rpx;
  font-weight: 900;
}

.progress-summary {
  margin-top: 8rpx;
  color: #2d2822;
  font-size: 32rpx;
  font-weight: 900;
}

.total-pages,
.page-num {
  color: #7c7164;
  font-size: 24rpx;
  font-weight: 800;
}

.progress-row {
  margin-top: 30rpx;
}

.partner-progress {
  margin-top: 26rpx;
}

.progress-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
  color: #2d2822;
  font-size: 26rpx;
  font-weight: 900;
}

.avatar-mini,
.note-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 50%;
  color: #fff8ed;
  font-weight: 900;
}

.avatar-mini {
  width: 50rpx;
  height: 50rpx;
  font-size: 20rpx;
}

.avatar-mini.me,
.note-avatar-text.me {
  background: #5c8f75;
}

.avatar-mini.partner,
.note-avatar-text.partner {
  background: #b85c38;
}

.avatar-mini image,
.note-avatar image {
  width: 100%;
  height: 100%;
  display: block;
}

.progress-track {
  height: 18rpx;
  margin-top: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(124, 113, 100, 0.14);
}

.progress-fill {
  height: 100%;
  min-width: 20rpx;
  border-radius: 999rpx;
}

.progress-fill.me {
  background: #5c8f75;
}

.progress-fill.partner {
  background: #b85c38;
}

.finish-row {
  display: flex;
  gap: 14rpx;
  margin-top: 28rpx;
}

.finish-chip {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(124, 113, 100, 0.1);
  color: #7c7164;
  font-size: 22rpx;
  font-weight: 800;
}

.finish-chip.done {
  background: rgba(92, 143, 117, 0.14);
  color: #4f7b65;
}

.finish-tip {
  margin-top: 16rpx;
  color: #a54f33;
  font-size: 23rpx;
  line-height: 1.55;
}

.finish-tip.success {
  color: #4f7b65;
}

.action-card {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
}

.action-title {
  color: #2d2822;
  font-size: 34rpx;
  font-weight: 900;
}

.action-desc {
  margin-top: 10rpx;
  color: #7c7164;
  font-size: 25rpx;
  line-height: 1.65;
}

.section-header {
  margin-top: 42rpx;
  padding: 0 6rpx;
}

.section-title {
  color: #2d2822;
  font-size: 32rpx;
  font-weight: 900;
}

.section-desc {
  margin-top: 6rpx;
  color: #7c7164;
  font-size: 23rpx;
  font-weight: 800;
}

.locate-btn {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(184, 92, 56, 0.12);
  color: #a54f33;
  font-size: 23rpx;
  font-weight: 900;
}

.notes-stream {
  margin-top: 20rpx;
  max-height: none;
}

.empty-notes {
  padding: 44rpx 24rpx;
  border: 1rpx dashed rgba(120, 98, 72, 0.24);
  border-radius: 32rpx;
  color: #7c7164;
  font-size: 26rpx;
  line-height: 1.6;
  text-align: center;
}

.note-card {
  margin-top: 22rpx;
  padding: 30rpx;
}

.note-me {
  border-left: 6rpx solid #5c8f75;
}

.note-partner {
  border-left: 6rpx solid #b85c38;
}

.note-user-info {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.note-avatar {
  width: 50rpx;
  height: 50rpx;
  flex-shrink: 0;
  font-size: 20rpx;
}

.note-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.note-username {
  color: #2d2822;
  font-size: 24rpx;
  font-weight: 900;
}

.note-page,
.note-time {
  color: #8a7d6e;
  font-size: 21rpx;
  font-weight: 800;
}

.note-content-box {
  margin-top: 22rpx;
}

.note-text {
  color: #2d2822;
  font-size: 28rpx;
  line-height: 1.75;
}

.quote-block {
  padding: 24rpx 26rpx;
  border-radius: 24rpx;
  background: rgba(92, 143, 117, 0.08);
  border-left: 6rpx solid #5c8f75;
}

.quote-label,
.note-comment-label {
  color: #4f7b65;
  font-size: 22rpx;
  font-weight: 900;
}

.quote-text {
  display: block;
  margin-top: 10rpx;
  color: #2d2822;
  font-size: 28rpx;
  line-height: 1.72;
}

.note-comment {
  margin-top: 18rpx;
}

.note-comment.compact {
  margin-top: 0;
  margin-bottom: 20rpx;
}

.composer-quote {
  padding: 22rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(92, 143, 117, 0.08);
  border: 1rpx solid rgba(92, 143, 117, 0.18);
}

.composer-quote-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.composer-quote-label {
  color: #4f7b65;
  font-size: 22rpx;
  font-weight: 900;
}

.composer-quote-clear {
  color: #a54f33;
  font-size: 22rpx;
  font-weight: 800;
}

.composer-quote-text {
  display: block;
  margin-top: 12rpx;
  color: #2d2822;
  font-size: 26rpx;
  line-height: 1.65;
}

.reply-context {
  margin-bottom: 18rpx;
}

.reply-thread {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(239, 226, 207, 0.42);
}

.reply-thread-title {
  margin-bottom: 14rpx;
  color: #7c7164;
  font-size: 22rpx;
  font-weight: 900;
}

.reply-item {
  padding: 16rpx 0;
  border-top: 1rpx solid rgba(120, 98, 72, 0.1);
}

.reply-item:first-of-type {
  border-top: none;
  padding-top: 0;
}

.reply-item-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.report-link {
  margin-left: auto;
  flex-shrink: 0;
  color: #9a8e7e;
  font-size: 22rpx;
  padding: 4rpx 8rpx;
}

.reply-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.reply-avatar-text {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff8ed;
  font-size: 18rpx;
  font-weight: 900;
}

.reply-meta {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.reply-user {
  color: #2d2822;
  font-size: 24rpx;
  font-weight: 900;
}

.reply-time {
  color: #8a7d6e;
  font-size: 20rpx;
}

.reply-content {
  display: block;
  margin-top: 10rpx;
  padding-left: 56rpx;
  color: #2d2822;
  font-size: 26rpx;
  line-height: 1.6;
}

.reply-mine .reply-content {
  color: #2d2822;
}

.note-locked {
  padding: 30rpx 26rpx;
  border: 1rpx dashed rgba(120, 98, 72, 0.2);
  border-radius: 28rpx;
  background: rgba(239, 226, 207, 0.46);
  text-align: center;
}

.lock-text {
  color: #2d2822;
  font-size: 26rpx;
  font-weight: 900;
}

.lock-hint {
  margin-top: 10rpx;
  color: #7c7164;
  font-size: 23rpx;
  line-height: 1.6;
}

.note-footer {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(120, 98, 72, 0.12);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.reply-btn {
  color: #4f7b65;
  font-size: 24rpx;
  font-weight: 900;
}

.share-btn {
  color: #a54f33;
  font-size: 24rpx;
  font-weight: 900;
}

.share-done {
  color: #8a7d6e;
  font-size: 24rpx;
  font-weight: 800;
}

.share-hint {
  margin-bottom: 20rpx;
  color: #7c7164;
  font-size: 24rpx;
  line-height: 1.6;
}

.share-textarea {
  width: 100%;
  height: 220rpx;
  padding: 28rpx 30rpx;
  border: 1rpx solid rgba(120, 98, 72, 0.16);
  border-radius: 30rpx;
  background: #fbf7ef;
  color: #2d2822;
  font-size: 28rpx;
  line-height: 1.55;
  box-sizing: border-box;
}

.share-confirm-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  color: #7c7164;
  font-size: 24rpx;
}

.share-checkbox {
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid rgba(124, 113, 100, 0.32);
  border-radius: 10rpx;
}

.share-checkbox.checked {
  border-color: #5c8f75;
  background: #5c8f75;
}

.replies-list {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(92, 143, 117, 0.08);
}

.reply-item {
  margin-bottom: 8rpx;
  color: #2d2822;
  font-size: 24rpx;
  line-height: 1.55;
}

.reply-item:last-child {
  margin-bottom: 0;
}

.reply-user {
  color: #4f7b65;
  font-weight: 900;
}

.load-more-wrap {
  padding: 28rpx 0 10rpx;
  display: flex;
  justify-content: center;
}

.btn-load-more {
  width: 240rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: rgba(92, 143, 117, 0.1);
  color: #4f7b65;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 72rpx;
}

.btn-load-more::after {
  border: none;
}

.composer-form {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
}

.page-input-box {
  min-height: 128rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 18rpx 30rpx;
  border: 1rpx solid rgba(120, 98, 72, 0.16);
  border-radius: 30rpx;
  background: #fbf7ef;
  box-sizing: border-box;
}

.page-input {
  width: 180rpx;
  color: #4f7b65;
  font-size: 56rpx;
  font-weight: 900;
  line-height: 72rpx;
  min-height: 72rpx;
}

.total-pages-label {
  color: #8a7d6e;
  font-size: 28rpx;
  font-weight: 800;
}

.note-textarea,
.reply-textarea {
  width: 100%;
  padding: 28rpx 30rpx;
  border: 1rpx solid rgba(120, 98, 72, 0.16);
  border-radius: 30rpx;
  background: #fbf7ef;
  color: #2d2822;
  font-size: 30rpx;
  line-height: 46rpx;
  box-sizing: border-box;
}

.note-textarea {
  height: 230rpx;
}

.reply-textarea {
  height: 300rpx;
  margin-bottom: 36rpx;
}

.finish-checkbox {
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: #7c7164;
  font-size: 26rpx;
  font-weight: 800;
}

.checkbox-icon {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid rgba(124, 113, 100, 0.32);
  border-radius: 12rpx;
}

.finish-checkbox.checked .checkbox-icon {
  border-color: #5c8f75;
  background: #5c8f75;
}

.lock-warning {
  padding: 18rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(184, 92, 56, 0.1);
  color: #a54f33;
  font-size: 23rpx;
  line-height: 1.55;
}

.modal-submit {
  width: 100%;
  margin-top: 34rpx;
}
