<view class="journal-page">
  <view class="page-bg"></view>

  <block wx:if="{{!book}}">
    <view class="empty-state">
      <view class="eyebrow">我们的记录</view>
      <view class="empty-title">还没有正在共读的书</view>
      <view class="empty-desc">先和伙伴选定一本书，这里会用于同步页码、阅读状态和进度备注。</view>
      <button class="btn-primary w-full" bindtap="onBackHome">回到共读首页</button>
    </view>
  </block>

  <block wx:else>
    <view class="page-head" bindtap="onTapOpenPairProgress">
      <view>
        <view class="eyebrow">我们的记录</view>
        <view class="page-title">{{book.title}}</view>
        <view class="page-desc">{{book.author || '作者未填写'}} · 第{{book.reading_days || 1}}天</view>
        <view class="page-head-hint">点此更新阅读进度</view>
      </view>
      <view class="book-seal">同读</view>
    </view>

    <view class="relation-strip">
      <view class="relation-duo">
        <view class="relation-person">
          <view class="avatar-mini me">
            <block wx:if="{{user.avatar}}"><image src="{{user.avatar}}" mode="aspectFill"></image></block>
            <block wx:else>{{userInitial}}</block>
          </view>
          <text>{{user.nickname || '我'}} · {{book.my_progress}} 页</text>
        </view>
        <view class="relation-bridge"></view>
        <view class="relation-person">
          <view class="avatar-mini partner">
            <block wx:if="{{partner.avatar}}"><image src="{{partner.avatar}}" mode="aspectFill"></image></block>
            <block wx:else>{{partnerInitial}}</block>
          </view>
          <text>{{partner.nickname || 'TA'}} · {{book.partner_progress}} 页</text>
        </view>
      </view>
      <view class="relation-strip-main">{{book.progress_summary}}</view>
      <view class="relation-strip-meta">共 {{book.total_pages}} 页 · 第 {{book.reading_days || 1}} 天共读</view>
      <view class="finish-tip" wx:if="{{book.my_finished && !book.partner_finished}}">你已读完，等伙伴完成后会自动归档。</view>
      <view class="finish-tip success" wx:if="{{book.my_finished && book.partner_finished}}">你们都读完了，这本书会进入共同记忆。</view>
    </view>

    <view class="action-card">
      <view>
        <view class="action-title">更新阅读进度</view>
        <view class="action-desc">记录页码、阅读状态和备注，仅在已绑定共读关系内展示。</view>
      </view>
      <button class="btn-primary w-full" bindtap="onOpenComposer">记一笔 / 更新进度</button>
    </view>

    <view class="section-header">
      <view>
        <view class="section-title">进度记录</view>
        <view class="section-desc">{{entries.length}} 条阅读进度</view>
      </view>
      <view class="locate-btn" wx:if="{{unreadCount > 0}}" bindtap="onLocateNextUnread">{{unreadCount}} 条未读更新</view>
    </view>

    <scroll-view class="notes-stream" scroll-y enhanced scroll-with-animation scroll-into-view="{{scrollIntoViewId}}">
      <block wx:if="{{entries.length === 0}}">
        <view class="empty-notes">还没有进度记录，先记录今天读到哪里。</view>
      </block>

      <block wx:for="{{entries}}" wx:key="entry_id">
        <view id="entry-{{item.entry_id}}" class="note-card {{item.is_mine ? 'note-me' : 'note-partner'}}">
          <view class="note-header">
            <view class="note-user-info">
              <block wx:if="{{item.avatar}}">
                <image class="note-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
              </block>
              <block wx:else>
                <view class="note-avatar note-avatar-text {{item.is_mine ? 'me' : 'partner'}}">{{item.entryInitial}}</view>
              </block>
              <view class="note-meta">
                <text class="note-username">{{item.nickname}}</text>
                <text class="note-page">第{{item.page}}页</text>
              </view>
            </view>
            <text class="note-time">{{item.created_at}}</text>
            <view
              wx:if="{{!item.is_mine && !item.is_locked}}"
              class="report-link"
              catchtap="onReportEntry"
              data-entry-id="{{item.entry_id}}"
              data-user-id="{{item.user_id}}"
              data-nickname="{{item.nickname}}"
              data-snapshot="{{item.quote_text || item.note_content}}"
            >反馈</view>
          </view>

          <view
            class="note-content-box {{item.is_locked ? 'note-locked' : ''}}"
            bindtap="onTapEntryBody"
            data-page="{{item.unlock_at_page}}"
            data-is-locked="{{item.is_locked}}"
          >
            <block wx:if="{{item.is_locked}}">
              <view class="lock-text">这一段先替你们收起来</view>
              <view class="lock-hint">读到第 {{item.unlock_at_page}} 页即可解锁，避免提前剧透。</view>
            </block>
            <block wx:else>
              <view wx:if="{{item.has_quote}}" class="quote-block">
                <view class="quote-label">原文</view>
                <text class="quote-text">“{{item.quote_text}}”</text>
              </view>
              <view wx:if="{{item.has_comment}}" class="note-comment">
                <view class="note-comment-label" wx:if="{{item.has_quote}}">备注</view>
                <text class="note-text">{{item.note_content}}</text>
              </view>
              <text wx:if="{{!item.has_quote && !item.has_comment}}" class="note-text">这一页没有填写备注，只更新了进度。</text>
            </block>
          </view>

          <block wx:if="{{!item.is_locked}}">
            <view class="note-footer">
              <view class="reply-btn" bindtap="onOpenReplyPopup" data-entry-id="{{item.entry_id}}">
                {{item.replies && item.replies.length ? '补充备注' : '添加补充备注'}}
              </view>
            </view>
            <view class="reply-thread" wx:if="{{item.replies && item.replies.length > 0}}">
              <view class="reply-thread-title">补充备注 · {{item.replies.length}} 条</view>
              <view class="reply-item {{reply.is_mine ? 'reply-mine' : 'reply-partner'}}" wx:for="{{item.replies}}" wx:for-item="reply" wx:key="reply_id">
                <view class="reply-item-head">
                  <view class="reply-avatar reply-avatar-text {{reply.is_mine ? 'me' : 'partner'}}">{{reply.replyInitial}}</view>
                  <view class="reply-meta">
                    <text class="reply-user">{{reply.nickname}}</text>
                    <text class="reply-time">{{reply.created_at}}</text>
                  </view>
                  <view
                    wx:if="{{!reply.is_mine}}"
                    class="report-link"
                    catchtap="onReportReply"
                    data-reply-id="{{reply.reply_id}}"
                    data-user-id="{{reply.user_id}}"
                    data-nickname="{{reply.nickname}}"
                    data-content="{{reply.content}}"
                  >反馈</view>
                </view>
                <text class="reply-content">{{reply.content}}</text>
              </view>
            </view>
          </block>
        </view>
      </block>

      <view class="load-more-wrap" wx:if="{{entryHasMore}}">
        <button class="btn-load-more" loading="{{entryLoadingMore}}" bindtap="onLoadMoreEntries">加载更多</button>
      </view>
    </scroll-view>
  </block>

  <view class="modal-overlay" wx:if="{{showComposer}}" bindtap="onCloseComposer">
    <view class="modal-content" catchtap="noop">
      <view class="modal-header-line"></view>
      <view class="modal-padding">
        <view class="modal-header">
          <text class="modal-title">更新阅读进度</text>
          <view class="close-icon" bindtap="onCloseComposer">×</view>
        </view>

        <view class="composer-form">
          <view class="page-input-box">
            <input class="page-input" type="number" data-field="page" placeholder="{{book.my_progress || 0}}" value="{{entryForm.page}}" bindinput="onEntryFieldInput" />
            <text class="total-pages-label">/ {{book.total_pages}}</text>
          </view>

          <view wx:if="{{entryForm.quote_text}}" class="composer-quote">
            <view class="composer-quote-head">
              <text class="composer-quote-label">引用的原文</text>
              <text class="composer-quote-clear" bindtap="onClearQuote">清除</text>
            </view>
            <text class="composer-quote-text">“{{entryForm.quote_text}}”</text>
          </view>

          <textarea
            class="note-textarea"
            data-field="note_content"
            maxlength="200"
            placeholder="阅读备注，仅用于共读进度记录"
            value="{{entryForm.note_content}}"
            bindinput="onEntryFieldInput"
          ></textarea>

          <view class="finish-checkbox {{entryForm.mark_finished ? 'checked' : ''}}" bindtap="onToggleFinished">
            <view class="checkbox-icon"></view>
            <text>我已读完本书</text>
          </view>

          <view class="lock-warning" wx:if="{{entryForm.page > book.partner_progress}}">
            <text>你已超过对方进度，这条记录会先锁住，等对方读到后再打开。</text>
          </view>
        </view>

        <view class="lock-warning">
          <text>该记录仅用于已绑定共读关系内的进度同步，不进入公共页面，也不向陌生人展示。</text>
        </view>

        <button class="btn-primary modal-submit" loading="{{entrySubmitting}}" bindtap="onSubmitEntry">保存进度</button>
      </view>
    </view>
  </view>

  <view class="modal-overlay" wx:if="{{showReplyPopup}}" bindtap="onCloseReplyPopup">
    <view class="modal-content" catchtap="noop">
      <view class="modal-header-line"></view>
      <view class="modal-padding">
        <view class="modal-header">
          <text class="modal-title">补充阅读备注</text>
          <view class="close-icon" bindtap="onCloseReplyPopup">×</view>
        </view>

        <view wx:if="{{activeReplyQuote}}" class="reply-context quote-block">
          <view class="quote-label">原文</view>
          <text class="quote-text">“{{activeReplyQuote}}”</text>
        </view>
        <view wx:if="{{activeReplyNote}}" class="reply-context note-comment compact">
          <view class="note-comment-label">对方备注</view>
          <text class="note-text">{{activeReplyNote}}</text>
        </view>

        <textarea class="reply-textarea" maxlength="200" placeholder="添加一条补充备注…" value="{{replyContent}}" bindinput="onReplyInput"></textarea>

        <button class="btn-primary modal-submit" loading="{{replySubmitting}}" bindtap="onSubmitReply">保存备注</button>
      </view>
    </view>
  </view>
</view>
