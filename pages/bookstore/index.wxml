<view class="container">
  <view class="shelf-tabs">
    <view
      class="shelf-tab {{shelfTab === 'browse' ? 'active' : ''}}"
      data-tab="browse"
      bindtap="onShelfTabTap"
    >浏览</view>
    <view
      class="shelf-tab {{shelfTab === 'favorites' ? 'active' : ''}}"
      data-tab="favorites"
      bindtap="onShelfTabTap"
    >收藏</view>
    <view
      class="shelf-tab {{shelfTab === 'recent' ? 'active' : ''}}"
      data-tab="recent"
      bindtap="onShelfTabTap"
    >最近阅读</view>
  </view>

  <view class="search-bar" wx:if="{{shelfTab === 'browse'}}">
    <view class="search-input-box">
      <icon type="search" size="16" color="#999" />
      <input
        class="search-input"
        placeholder="搜索书名、作者"
        value="{{keyword}}"
        bindinput="onKeywordInput"
        confirm-type="search"
        bindconfirm="onSearchConfirm"
      />
    </view>
  </view>

  <view class="import-toolbar">
    <view class="import-toolbar-hint" wx:if="{{txtPrivacyReadyHint}}">已完成隐私授权，请点击「从聊天记录导入 TXT」继续选择文件</view>
    <button
      wx:if="{{supportTxtAgreeBtn && txtNeedsPrivacyAuthorization}}"
      class="import-btn import-btn-txt"
      plain
      hover-class="import-btn--hover"
      loading="{{txtPickerBusy}}"
      disabled="{{txtPickerBusy}}"
      open-type="agreePrivacyAuthorization"
      bindtap="onTapImportTxt"
      bindagreeprivacyauthorization="onWxAgreeThenPickTxt"
    >从聊天记录导入 TXT</button>
    <button
      wx:else
      class="import-btn import-btn-txt"
      plain
      hover-class="import-btn--hover"
      loading="{{txtPickerBusy}}"
      disabled="{{txtPickerBusy}}"
      bindtap="onTapImportTxtFallback"
    >从聊天记录导入 TXT</button>
    <button class="import-btn import-btn-link" plain hover-class="import-btn--hover" bindtap="onOpenUrlPopup">导入网页 / TXT 链接</button>
  </view>

  <view class="store-hint" wx:if="{{shelfTab === 'browse' && storeHint}}">{{storeHint}}</view>

  <scroll-view wx:if="{{shelfTab === 'browse'}}" class="category-scroll" scroll-x enable-flex>
    <view class="category-list">
      <view
        wx:for="{{categories}}"
        wx:key="key"
        class="category-item {{selectedCategory === item.key ? 'active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onCategoryTap"
      >
        {{item.name}}
      </view>
    </view>
  </scroll-view>

  <view class="wr-list-panel">
    <view wx:if="{{loading && !books.length}}" class="wr-list">
      <view wx:for="{{[1,2,3,4,5]}}" wx:key="*this" class="wr-row wr-row--sk">
        <view class="wr-cover sk-block"></view>
        <view class="wr-main">
          <view class="sk-line sk-line--title"></view>
          <view class="sk-line sk-line--author"></view>
          <view class="sk-line sk-line--reason"></view>
        </view>
      </view>
    </view>

    <view wx:elif="{{!books.length}}" class="wr-empty">
      <view class="wr-empty-title" wx:if="{{shelfTab === 'browse'}}">暂无匹配书籍</view>
      <view class="wr-empty-title" wx:elif="{{shelfTab === 'favorites'}}">暂无收藏</view>
      <view class="wr-empty-title" wx:else>暂无阅读记录</view>
      <view class="wr-empty-desc" wx:if="{{shelfTab === 'browse'}}">切换分类或搜索书名、作者试试</view>
      <view class="wr-empty-desc" wx:elif="{{shelfTab === 'favorites'}}">在书籍详情页点击「收藏」后会出现在这里</view>
      <view class="wr-empty-desc" wx:else>打开正文阅读后，进度会记录在此</view>
    </view>

    <view wx:else class="wr-list">
      <view
        wx:for="{{books}}"
        wx:key="catalog_id"
        class="wr-row"
        data-id="{{item.catalog_id}}"
        bindtap="onBookTap"
      >
        <view class="wr-cover-wrap">
          <image
            wx:if="{{item.cover_url}}"
            class="wr-cover"
            mode="aspectFill"
            src="{{item.cover_url}}"
          />
          <view wx:else class="wr-cover wr-cover--ph">
            <text class="wr-cover-letter">{{item.cover_initial}}</text>
          </view>
        </view>
        <view class="wr-main">
          <view class="wr-title">{{item.title}}</view>
          <view class="wr-sub">
            <text class="wr-author">{{item.author_line}}</text>
            <text class="wr-dot" wx:if="{{item.read_tag}}"> · </text>
            <text class="wr-tag" wx:if="{{item.read_tag}}">{{item.read_tag}}</text>
          </view>
          <view class="wr-recommend">
            <text class="wr-pct" wx:if="{{item.recommend_text}}">{{item.recommend_text}}</text>
            <text class="wr-reason">{{item.reason_line}}</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{loading && books.length}}" class="wr-footer">加载中…</view>
    <view wx:if="{{!loading && books.length && !hasMore}}" class="wr-footer">— 已显示全部 —</view>
  </view>

  <view class="import-sheet-overlay" wx:if="{{showUrlPopup}}" bindtap="onCloseUrlPopup">
    <view class="import-sheet" catchtap="noop">
      <view class="import-sheet-head">
        <text class="import-sheet-title">导入网络阅读链接</text>
        <view class="import-sheet-close" bindtap="onCloseUrlPopup">×</view>
      </view>
      <view class="import-sheet-hint">优先导入 TXT/HTML 正文；无法提取时保存为外链书目。</view>
      <scroll-view class="import-sheet-body" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="import-field">
          <text class="import-field-label">书名</text>
          <input class="import-field-input" placeholder="请输入书名" data-field="title" value="{{urlForm.title}}" bindinput="onUrlFieldInput" />
        </view>
        <view class="import-field">
          <text class="import-field-label">作者（选填）</text>
          <input class="import-field-input" placeholder="作者名" data-field="author" value="{{urlForm.author}}" bindinput="onUrlFieldInput" />
        </view>
        <view class="import-field">
          <text class="import-field-label">阅读链接</text>
          <input class="import-field-input" placeholder="https:// 开头的 TXT 或网页地址" data-field="read_url" value="{{urlForm.read_url}}" bindinput="onUrlFieldInput" />
        </view>
        <view class="import-field">
          <text class="import-field-label">预估页数（选填）</text>
          <input class="import-field-input" type="number" placeholder="无法提取正文时默认 400" data-field="estimated_pages" value="{{urlForm.estimated_pages}}" bindinput="onUrlFieldInput" />
        </view>
      </scroll-view>
      <view class="import-sheet-foot">
        <button class="import-sheet-btn import-sheet-btn--ghost" bindtap="onCloseUrlPopup">取消</button>
        <button class="import-sheet-btn import-sheet-btn--primary" loading="{{urlSubmitting}}" bindtap="onSubmitUrlImport">保存</button>
      </view>
    </view>
  </view>

  <view class="import-sheet-overlay" wx:if="{{showTxtPopup}}" bindtap="onCloseTxtPopup">
    <view class="import-sheet import-sheet--compact" catchtap="noop">
      <view class="import-sheet-head">
        <text class="import-sheet-title">导入 TXT 全书</text>
        <view class="import-sheet-close" bindtap="onCloseTxtPopup">×</view>
      </view>
      <view class="import-sheet-hint">将打开微信文件选择器：先选含有文件的会话或「文件传输助手」，再选该会话里的 .txt；没有 TXT 时会显示空列表。编码支持 UTF-8 / GB18030。</view>
      <view class="import-txt-file-row">
        <text class="import-txt-file-label">已选文件</text>
        <text class="import-txt-file-name">{{txtFileName || '未选择'}}</text>
        <button
          wx:if="{{supportTxtAgreeBtn && txtNeedsPrivacyAuthorization}}"
          class="import-txt-pick"
          plain
          hover-class="import-txt-pick--hover"
          loading="{{txtPickerBusy}}"
          disabled="{{txtPickerBusy}}"
          open-type="agreePrivacyAuthorization"
          bindtap="onTapImportTxt"
          bindagreeprivacyauthorization="onWxAgreeThenPickTxt"
        >从聊天记录选择</button>
        <button
          wx:else
          class="import-txt-pick"
          plain
          hover-class="import-txt-pick--hover"
          loading="{{txtPickerBusy}}"
          disabled="{{txtPickerBusy}}"
          catchtap="onTapImportTxtFallback"
        >从聊天记录选择</button>
      </view>
      <scroll-view class="import-sheet-body import-sheet-body--short" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="import-field">
          <text class="import-field-label">书名</text>
          <input class="import-field-input" placeholder="请输入书名" value="{{txtForm.title}}" bindinput="onTxtFieldInput" data-field="title" />
        </view>
        <view class="import-field">
          <text class="import-field-label">作者（选填）</text>
          <input class="import-field-input" placeholder="作者名" value="{{txtForm.author}}" bindinput="onTxtFieldInput" data-field="author" />
        </view>
      </scroll-view>
      <view class="import-sheet-foot">
        <button class="import-sheet-btn import-sheet-btn--ghost" bindtap="onCloseTxtPopup">取消</button>
        <button class="import-sheet-btn import-sheet-btn--primary" loading="{{txtSubmitting}}" bindtap="onSubmitTxtImport">开始导入</button>
      </view>
    </view>
  </view>
</view>
