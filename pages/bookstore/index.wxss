/* 书城列表：微信读书式行布局 + 全站温润纸感配色（与 app.wxss 一致） */

.container {
  min-height: 100vh;
  padding-bottom: 240rpx;
  background:
    radial-gradient(circle at 90% 4%, rgba(92, 143, 117, 0.14), transparent 220rpx),
    linear-gradient(180deg, #fbf6ec 0%, #f3eadb 100%);
  box-sizing: border-box;
}

.shelf-tabs {
  display: flex;
  gap: 12rpx;
  padding: 44rpx 30rpx 12rpx;
  box-sizing: border-box;
}

.shelf-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 12rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #6e6255;
  background: rgba(255, 251, 243, 0.65);
  border: 1rpx solid rgba(120, 98, 72, 0.12);
  box-sizing: border-box;
}

.shelf-tab.active {
  color: #fff8ed;
  background: linear-gradient(135deg, #5c8f75, #477560);
  border-color: transparent;
  box-shadow: 0 10rpx 24rpx rgba(71, 117, 96, 0.22);
}

.search-bar {
  position: sticky;
  top: 0;
  z-index: 30;
  padding: 0 30rpx 18rpx;
  background: rgba(246, 239, 227, 0.9);
  backdrop-filter: blur(12px);
}

.search-input-box {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  padding: 16rpx 28rpx;
  border: 1rpx solid rgba(120, 98, 72, 0.14);
  border-radius: 30rpx;
  background: rgba(255, 251, 243, 0.88);
  box-shadow: 0 10rpx 28rpx rgba(69, 47, 26, 0.06);
  box-sizing: border-box;
}

.search-input {
  flex: 1;
  margin-left: 16rpx;
  color: #2d2822;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 44rpx;
  min-height: 44rpx;
}

.import-toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 30rpx 16rpx;
  box-sizing: border-box;
}

.import-toolbar-hint {
  width: 100%;
  flex-basis: 100%;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #4f7b65;
  background: rgba(92, 143, 117, 0.12);
  border: 1rpx solid rgba(92, 143, 117, 0.2);
  box-sizing: border-box;
}

.import-btn {
  flex: 1;
  margin: 0;
  padding: 0 12rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 22rpx;
  font-size: 26rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.import-btn-txt {
  background: linear-gradient(135deg, #5c8f75, #477560);
  color: #fff8ed;
}

.import-btn-link {
  border: 1rpx solid rgba(92, 143, 117, 0.35);
  background: rgba(255, 251, 243, 0.85);
  color: #4f7b65;
}

.import-btn-share {
  border: 1rpx solid rgba(61, 107, 82, 0.22);
  background: #e8f3ec;
  color: #3d6b52;
}

.import-btn::after {
  border: none;
}

.import-btn--hover {
  opacity: 0.88;
}

.import-btn--disabled {
  opacity: 0.55;
  pointer-events: none;
}

.import-txt-file-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 28rpx 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 251, 243, 0.9);
  border: 1rpx solid rgba(120, 98, 72, 0.12);
  box-sizing: border-box;
}

.import-txt-file-label {
  font-size: 24rpx;
  color: #8a7d6e;
  flex-shrink: 0;
}

.import-txt-file-name {
  flex: 1;
  font-size: 24rpx;
  color: #2d2822;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.import-txt-pick {
  flex-shrink: 0;
  margin: 0;
  padding: 10rpx 20rpx;
  line-height: 1.4;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #5c8f75, #477560);
  color: #fff8ed;
  font-size: 24rpx;
  font-weight: 800;
}

.import-txt-pick::after {
  border: none;
}

.import-txt-pick--hover {
  opacity: 0.88;
}

.store-hint {
  margin: 0 30rpx 12rpx;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  background: rgba(184, 92, 56, 0.1);
  color: #8b4d30;
  font-size: 24rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.category-scroll {
  width: 100%;
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  gap: 14rpx;
  padding: 8rpx 30rpx 22rpx;
}

.category-item {
  padding: 16rpx 24rpx;
  border: 1rpx solid rgba(120, 98, 72, 0.14);
  border-radius: 999rpx;
  background: rgba(255, 251, 243, 0.62);
  color: #7c7164;
  font-size: 25rpx;
  font-weight: 800;
}

.category-item.active {
  border-color: rgba(92, 143, 117, 0.26);
  background: rgba(92, 143, 117, 0.14);
  color: #4f7b65;
  font-weight: 900;
}

.wr-list-panel {
  margin: 0 30rpx;
  border: 1rpx solid rgba(120, 98, 72, 0.16);
  border-radius: 28rpx;
  overflow: hidden;
  background: rgba(255, 251, 243, 0.92);
  box-shadow: 0 16rpx 42rpx rgba(69, 47, 26, 0.08);
  box-sizing: border-box;
}

.wr-list {
  background: transparent;
}

.wr-row {
  display: flex;
  align-items: flex-start;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid rgba(231, 220, 203, 0.95);
  box-sizing: border-box;
}

.wr-row:last-child {
  border-bottom: none;
}

.wr-row:active {
  background: rgba(251, 247, 239, 0.95);
}

.wr-cover-wrap {
  flex-shrink: 0;
  margin-right: 24rpx;
}

.wr-cover {
  width: 120rpx;
  height: 168rpx;
  border-radius: 18rpx 10rpx 10rpx 18rpx;
  background: #e8dfd2;
  display: block;
  box-shadow: 10rpx 12rpx 24rpx rgba(69, 47, 26, 0.12);
}

.wr-cover--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #8f4d35, #c98a5a);
}

.wr-cover-letter {
  font-size: 48rpx;
  font-weight: 900;
  color: #fff8ed;
}

.wr-main {
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
}

.wr-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 32rpx;
  font-weight: 900;
  color: #2d2822;
  line-height: 1.35;
  margin-bottom: 10rpx;
}

.wr-sub {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  line-height: 1.35;
}

.wr-author {
  color: #7c7164;
  font-weight: 800;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wr-dot {
  color: #d9d0c2;
}

.wr-tag {
  color: #8a7d6e;
  font-size: 22rpx;
  font-weight: 800;
}

.wr-recommend {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 8rpx 12rpx;
  line-height: 1.5;
}

.wr-pct {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 900;
  color: #4f7b65;
}

.wr-reason {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  color: #6e6255;
  font-weight: 700;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.wr-footer {
  padding: 28rpx 0 36rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 800;
  color: #8a7d6e;
}

.wr-empty {
  padding: 72rpx 40rpx;
  text-align: center;
}

.wr-empty-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #2d2822;
  margin-bottom: 12rpx;
}

.wr-empty-desc {
  font-size: 26rpx;
  color: #8a7d6e;
  line-height: 1.55;
  font-weight: 700;
}

/* 骨架屏 */
.wr-row--sk .sk-block {
  width: 120rpx;
  height: 168rpx;
  border-radius: 18rpx 10rpx 10rpx 18rpx;
  background: #e8dfd2;
}

.sk-line {
  height: 26rpx;
  border-radius: 10rpx;
  background: linear-gradient(90deg, #ebe4d8 0%, #f5f0e6 45%, #ebe4d8 100%);
  background-size: 200% 100%;
  animation: wr-sk 1.1s ease-in-out infinite;
  margin-bottom: 16rpx;
}

.sk-line--title {
  width: 72%;
  height: 30rpx;
}

.sk-line--author {
  width: 45%;
}

.sk-line--reason {
  width: 88%;
  margin-bottom: 0;
}

@keyframes wr-sk {
  0% {
    background-position: 100% 0;
  }
  100% {
    background-position: -100% 0;
  }
}

/* 导入弹窗：居中浮层，预留顶部导航栏 + 底部自定义 Tab */
.import-sheet-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding:
    calc(16rpx + env(safe-area-inset-top) + 88rpx)
    28rpx
    calc(16rpx + env(safe-area-inset-bottom) + 168rpx);
  background: rgba(45, 40, 34, 0.45);
  backdrop-filter: blur(4px);
  box-sizing: border-box;
}

.import-sheet {
  width: 100%;
  max-width: 680rpx;
  max-height: 100%;
  display: flex;
  flex-direction: column;
  border-radius: 36rpx;
  background: #fffbf3;
  border: 1rpx solid rgba(120, 98, 72, 0.14);
  box-shadow: 0 24rpx 60rpx rgba(69, 47, 26, 0.18);
  overflow: hidden;
  box-sizing: border-box;
}

.import-sheet-head {
  flex-shrink: 0;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 28rpx 28rpx 0;
  box-sizing: border-box;
}

.import-sheet-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 900;
  color: #2d2822;
  line-height: 1.35;
}

.import-sheet-close {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: -4rpx;
  border-radius: 999rpx;
  color: #9a8e7e;
  font-size: 44rpx;
  line-height: 1;
  background: rgba(246, 239, 227, 0.9);
}

.import-sheet-hint {
  flex-shrink: 0;
  padding: 12rpx 28rpx 0;
  font-size: 24rpx;
  color: #8a7d6e;
  line-height: 1.55;
  box-sizing: border-box;
}

.import-sheet-body {
  flex: 1;
  min-height: 0;
  max-height: 46vh;
  margin-top: 16rpx;
  padding: 8rpx 28rpx 12rpx;
  box-sizing: border-box;
}

.import-sheet-body--short {
  max-height: 32vh;
}

.import-field {
  margin-bottom: 24rpx;
}

.import-field:last-child {
  margin-bottom: 8rpx;
}

.import-field-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #7c7164;
}

.import-field-input {
  display: block;
  width: 100%;
  height: 88rpx;
  min-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(231, 220, 203, 0.95);
  background: rgba(251, 247, 239, 0.88);
  font-size: 28rpx;
  line-height: 88rpx;
  color: #2d2822;
  box-sizing: border-box;
}

.import-sheet-foot {
  flex-shrink: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 28rpx 24rpx;
  border-top: 1rpx solid rgba(231, 220, 203, 0.85);
  background: rgba(255, 251, 243, 0.98);
  box-sizing: border-box;
}

.import-sheet-btn {
  flex: 1;
  margin: 0;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.import-sheet-btn--ghost {
  background: rgba(246, 239, 227, 0.95);
  color: #6e6255;
}

.import-sheet-btn--primary {
  background: linear-gradient(135deg, #5c8f75, #477560);
  color: #fff8ed;
}

.import-sheet-btn::after {
  border: none;
}
