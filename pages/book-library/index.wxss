.library-page {
  min-height: 100vh;
  padding: 30rpx 28rpx 180rpx;
  box-sizing: border-box;
  background: #fbf6ec;
  color: #2f2a24;
}

.library-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 22rpx;
  margin-bottom: 24rpx;
}

.eyebrow {
  display: inline-flex;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #fffaf2;
  color: #9f5838;
  font-size: 23rpx;
  font-weight: 700;
}

.page-title {
  margin-top: 16rpx;
  font-size: 46rpx;
  line-height: 1.15;
  font-weight: 900;
}

.page-desc {
  margin-top: 12rpx;
  max-width: 520rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: #7b7064;
}

.manual-btn,
.empty-btn {
  border: 0;
  border-radius: 999rpx;
  background: #2f7d62;
  color: #fff;
  font-size: 26rpx;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  white-space: nowrap;
}

.manual-btn::after,
.empty-btn::after,
.add-btn::after,
.detail-btn::after {
  border: 0;
}

.shelf-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
  padding: 8rpx;
  border-radius: 24rpx;
  background: #efe5d5;
  margin-bottom: 20rpx;
}

.shelf-tab {
  height: 66rpx;
  line-height: 66rpx;
  border-radius: 18rpx;
  text-align: center;
  color: #776c60;
  font-size: 26rpx;
  font-weight: 700;
}

.shelf-tab.active {
  background: #fffaf2;
  color: #2f2a24;
  box-shadow: 0 8rpx 24rpx rgba(64, 43, 25, 0.08);
}

.search-box {
  height: 82rpx;
  border-radius: 24rpx;
  background: #fffaf2;
  border: 1rpx solid #eadfce;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.category-scroll {
  margin: 24rpx -28rpx 20rpx;
  white-space: nowrap;
}

.category-list {
  display: flex;
  gap: 16rpx;
  padding: 0 28rpx;
}

.category-item {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #f0e6d6;
  color: #756a5f;
  font-size: 25rpx;
}

.category-item.active {
  background: #2f7d62;
  color: #fff;
}

.book-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.book-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #fffaf2;
  border: 1rpx solid #eadfce;
}

.cover {
  width: 96rpx;
  height: 132rpx;
  flex: 0 0 96rpx;
  border-radius: 12rpx;
  background: #d8c4a7;
}

.cover-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 38rpx;
  font-weight: 900;
}

.book-main {
  flex: 1;
  min-width: 0;
}

.book-title {
  font-size: 30rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.book-meta {
  margin-top: 8rpx;
  color: #83786d;
  font-size: 24rpx;
}

.book-desc {
  margin-top: 8rpx;
  color: #a08f7d;
  font-size: 24rpx;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.recommend {
  color: #2f7d62;
  font-weight: 800;
  margin-right: 10rpx;
}

.add-btn {
  width: 104rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  background: #f0e6d6;
  color: #2f2a24;
  font-size: 25rpx;
  padding: 0;
}

.progress-line {
  margin-top: 12rpx;
  width: 100%;
  height: 10rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #eadfce;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: #2f7d62;
}

.empty-state {
  margin-top: 120rpx;
  text-align: center;
  color: #7b7064;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #2f2a24;
}

.empty-desc {
  margin: 16rpx auto 28rpx;
  max-width: 520rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.footer {
  padding: 32rpx 0;
  text-align: center;
  color: #a08f7d;
  font-size: 24rpx;
}

.skeleton .cover,
.sk {
  background: linear-gradient(90deg, #eee4d6 0%, #f8efe4 50%, #eee4d6 100%);
}

.sk {
  height: 24rpx;
  border-radius: 999rpx;
  margin-bottom: 16rpx;
}

.sk-title {
  width: 60%;
  height: 30rpx;
}

.sk-line {
  width: 86%;
}

.sk-line.short {
  width: 48%;
}

.detail-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(39, 34, 28, 0.42);
}

.detail-sheet {
  width: 100%;
  padding: 28rpx;
  border-radius: 32rpx 32rpx 0 0;
  background: #fffaf2;
  box-sizing: border-box;
}

.detail-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.detail-title {
  font-size: 32rpx;
  font-weight: 900;
}

.detail-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  color: #8a7d6e;
  background: #f0e6d6;
}

.detail-body {
  display: flex;
  gap: 24rpx;
}

.detail-cover {
  width: 140rpx;
  height: 188rpx;
  flex: 0 0 140rpx;
  border-radius: 16rpx;
  background: #d8c4a7;
}

.detail-cover-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 52rpx;
  font-weight: 900;
}

.detail-info {
  flex: 1;
  min-width: 0;
}

.detail-book-title {
  font-size: 34rpx;
  font-weight: 900;
}

.detail-meta {
  margin-top: 10rpx;
  color: #7b7064;
  font-size: 25rpx;
}

.detail-desc {
  margin-top: 18rpx;
  color: #6e6255;
  font-size: 26rpx;
  line-height: 1.55;
}

.detail-actions {
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 16rpx;
  margin-top: 30rpx;
}

.detail-btn {
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.detail-btn.ghost {
  background: #f0e6d6;
  color: #6e6255;
}

.detail-btn.primary {
  background: #2f7d62;
  color: #fff;
}
