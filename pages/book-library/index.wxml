<view class="library-page">
  <view class="library-hero">
    <view>
      <view class="eyebrow">书库</view>
      <view class="page-title">挑一本开始记录</view>
      <view class="page-desc">浏览书名、作者、页数和简要资料，把想读的书加入阅读进度。</view>
    </view>
    <button class="manual-btn" bindtap="onManualAdd">手动添加</button>
  </view>

  <view class="shelf-tabs">
    <view class="shelf-tab {{shelfTab === 'browse' ? 'active' : ''}}" data-tab="browse" bindtap="onShelfTabTap">资料库</view>
    <view class="shelf-tab {{shelfTab === 'records' ? 'active' : ''}}" data-tab="records" bindtap="onShelfTabTap">已加入</view>
  </view>

  <block wx:if="{{shelfTab === 'browse'}}">
    <view class="search-box">
      <icon type="search" size="16" color="#9b9287" />
      <input
        class="search-input"
        placeholder="搜索书名、作者"
        value="{{keyword}}"
        bindinput="onKeywordInput"
        bindconfirm="onSearchConfirm"
        confirm-type="search"
      />
    </view>

    <scroll-view class="category-scroll" scroll-x enable-flex>
      <view class="category-list">
        <view
          wx:for="{{categories}}"
          wx:key="key"
          class="category-item {{selectedCategory === item.key ? 'active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onCategoryTap"
        >{{item.name}}</view>
      </view>
    </scroll-view>

    <view wx:if="{{loading && !books.length}}" class="book-list">
      <view wx:for="{{[1,2,3,4]}}" wx:key="*this" class="book-row skeleton">
        <view class="cover"></view>
        <view class="book-main">
          <view class="sk sk-title"></view>
          <view class="sk sk-line"></view>
          <view class="sk sk-line short"></view>
        </view>
      </view>
    </view>

    <view wx:elif="{{!books.length}}" class="empty-state">
      <view class="empty-title">没有找到匹配书籍</view>
      <view class="empty-desc">可以换个关键词，或直接手动添加书名和页数。</view>
      <button class="empty-btn" bindtap="onManualAdd">手动添加</button>
    </view>

    <view wx:else class="book-list">
      <view wx:for="{{books}}" wx:key="id" class="book-row" data-id="{{item.id}}" bindtap="onBookTap">
        <image wx:if="{{item.cover_url}}" class="cover" src="{{item.cover_url}}" mode="aspectFill" />
        <view wx:else class="cover cover-fallback">{{item.cover_initial}}</view>
        <view class="book-main">
          <view class="book-title">{{item.title}}</view>
          <view class="book-meta">{{item.meta}}</view>
          <view class="book-desc">
            <text wx:if="{{item.recommend_text}}" class="recommend">{{item.recommend_text}}</text>
            <text>{{item.reason}}</text>
          </view>
        </view>
        <button
          class="add-btn"
          loading="{{addingId === item.id}}"
          disabled="{{!!addingId}}"
          data-id="{{item.id}}"
          catchtap="onAddBook"
        >加入</button>
      </view>
    </view>

    <view wx:if="{{loading && books.length}}" class="footer">加载中...</view>
    <view wx:if="{{!loading && books.length && !hasMore}}" class="footer">已显示全部</view>
  </block>

  <block wx:else>
    <view wx:if="{{recordLoading}}" class="book-list">
      <view wx:for="{{[1,2,3]}}" wx:key="*this" class="book-row skeleton">
        <view class="cover"></view>
        <view class="book-main">
          <view class="sk sk-title"></view>
          <view class="sk sk-line"></view>
          <view class="sk sk-line short"></view>
        </view>
      </view>
    </view>

    <view wx:elif="{{!records.length}}" class="empty-state">
      <view class="empty-title">还没有加入书籍</view>
      <view class="empty-desc">从资料库挑一本，或手动添加正在读的书。</view>
      <button class="empty-btn" data-tab="browse" bindtap="onShelfTabTap">去资料库</button>
    </view>

    <view wx:else class="book-list">
      <view wx:for="{{records}}" wx:key="id" class="book-row" data-id="{{item.id}}" bindtap="onOpenRecord">
        <image wx:if="{{item.cover_url}}" class="cover" src="{{item.cover_url}}" mode="aspectFill" />
        <view wx:else class="cover cover-fallback">{{item.cover_initial}}</view>
        <view class="book-main">
          <view class="book-title">{{item.title}}</view>
          <view class="book-meta">{{item.meta}}</view>
          <view class="progress-line">
            <view class="progress-fill" style="width: {{item.percent}}%;"></view>
          </view>
          <view class="book-desc">{{item.reason}}</view>
        </view>
        <button class="add-btn" data-id="{{item.id}}" catchtap="onOpenRecord">进度</button>
      </view>
    </view>
  </block>

  <view class="detail-mask" wx:if="{{showDetail}}" bindtap="onCloseDetail">
    <view class="detail-sheet" catchtap="noop">
      <view class="detail-head">
        <text class="detail-title">书籍资料</text>
        <view class="detail-close" bindtap="onCloseDetail">×</view>
      </view>
      <scroll-view class="detail-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="detail-body" wx:if="{{activeBook}}">
          <image wx:if="{{activeBook.cover_url}}" class="detail-cover" src="{{activeBook.cover_url}}" mode="aspectFill" />
          <view wx:else class="detail-cover detail-cover-fallback">{{activeBook.cover_initial}}</view>
          <view class="detail-info">
            <view class="detail-book-title">{{activeBook.title}}</view>
            <view class="detail-meta">{{activeBook.meta}}</view>
            <view class="detail-desc">{{activeBook.reason}}</view>
          </view>
        </view>
      </scroll-view>
      <view class="detail-actions">
        <button class="detail-btn ghost" bindtap="onCloseDetail">取消</button>
        <button class="detail-btn primary" loading="{{addingId === activeBook.id}}" bindtap="onAddBook">加入记录</button>
      </view>
    </view>
  </view>
</view>
