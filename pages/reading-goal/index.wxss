.asset-subpage {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 48rpx 34rpx calc(48rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 84% 6%, rgba(92, 143, 117, 0.14), transparent 220rpx),
    linear-gradient(180deg, #fbf6ec 0%, #f3eadb 100%);
}

.subpage-head {
  margin-bottom: 36rpx;
}

.subpage-eyebrow {
  display: inline-flex;
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(184, 92, 56, 0.24);
  border-radius: 999rpx;
  background: rgba(255, 251, 243, 0.72);
  color: #a54f33;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.subpage-title {
  margin-top: 22rpx;
  color: #2d2822;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.2;
}

.subpage-desc {
  margin-top: 16rpx;
  color: #7c7164;
  font-size: 27rpx;
  line-height: 1.65;
}

.state-text {
  text-align: center;
  color: #9a8e7e;
  font-size: 28rpx;
  padding: 80rpx 0;
}

.subpage-card {
  margin-bottom: 24rpx;
  padding: 28rpx 32rpx 32rpx;
  border: 1rpx solid rgba(120, 98, 72, 0.14);
  border-radius: 40rpx;
  background: var(--paper-card, #fffbf3);
  box-shadow: 0 18rpx 46rpx rgba(69, 47, 26, 0.06);
  box-sizing: border-box;
}

.progress-card {
  padding-bottom: 36rpx;
}

.progress-card-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #2d2822;
  margin-bottom: 24rpx;
}

.metric-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
}

.metric-row--spaced {
  margin-top: 28rpx;
}

.metric-label {
  color: #7c7164;
}

.metric-value {
  font-weight: 700;
  color: #2d2822;
}

.goal-track {
  margin-top: 14rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: rgba(124, 113, 100, 0.14);
  overflow: hidden;
}

.goal-track--last {
  margin-bottom: 4rpx;
}

.goal-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #5c8f75, #477560);
  transition: width 0.25s ease;
}

.goal-fill--day {
  background: linear-gradient(90deg, #e89456, #d9783a);
}

.section-cap {
  font-size: 28rpx;
  font-weight: 800;
  color: #2d2822;
  margin-bottom: 8rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(231, 220, 203, 0.85);
}

.form-field {
  padding-top: 24rpx;
}

.form-field--last {
  padding-bottom: 4rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #2d2822;
  margin-bottom: 14rpx;
}

.form-input {
  width: 100%;
  min-height: 112rpx;
  padding: 28rpx 28rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(231, 220, 203, 0.95);
  background: rgba(251, 247, 239, 0.85);
  font-size: 30rpx;
  line-height: 44rpx;
  color: #2d2822;
}

.subpage-actions {
  margin-top: 12rpx;
  padding-top: 8rpx;
}
