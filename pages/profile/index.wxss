.profile-page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  padding: 80rpx 34rpx 240rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 84% 6%, rgba(92, 143, 117, 0.14), transparent 220rpx),
    linear-gradient(180deg, #fbf6ec 0%, #f3eadb 100%);
}

.page-orb {
  position: absolute;
  left: -150rpx;
  top: 260rpx;
  width: 430rpx;
  height: 430rpx;
  border-radius: 50%;
  background: rgba(184, 92, 56, 0.1);
  pointer-events: none;
}

.login-state,
.page-head,
.user-card,
.partner-card,
.stats-card,
.goal-card,
.settings-card,
.logout-btn {
  position: relative;
  z-index: 1;
}

.login-state {
  min-height: calc(100vh - 260rpx);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.eyebrow {
  display: inline-flex;
  align-self: flex-start;
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(184, 92, 56, 0.24);
  border-radius: 999rpx;
  background: rgba(255, 251, 243, 0.72);
  color: #a54f33;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.hero-title,
.page-title {
  margin-top: 22rpx;
  color: #2d2822;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.14;
}

.hero-desc,
.page-desc {
  margin-top: 18rpx;
  color: #7c7164;
  font-size: 27rpx;
  line-height: 1.7;
}

.page-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.asset-chip {
  min-width: 104rpx;
  height: 72rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  justify-content: center;
  flex-shrink: 0;
  border: 1rpx solid rgba(92, 143, 117, 0.2);
  border-radius: 999rpx;
  background: rgba(92, 143, 117, 0.12);
  color: #4f7b65;
  font-size: 22rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.asset-chip text:first-child {
  font-size: 34rpx;
  line-height: 1;
}

.login-preview,
.user-card,
.partner-card,
.stats-card,
.goal-card,
.settings-card {
  margin-top: 34rpx;
  padding: 34rpx;
  border: 1rpx solid rgba(120, 98, 72, 0.16);
  border-radius: 40rpx;
  background: rgba(255, 251, 243, 0.88);
  box-shadow: 0 20rpx 54rpx rgba(69, 47, 26, 0.08);
  box-sizing: border-box;
}

.preview-row,
.user-card,
.partner-card,
.goal-header,
.setting-item {
  display: flex;
  align-items: center;
}

.preview-row {
  gap: 22rpx;
}

.preview-seal {
  width: 82rpx;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
  background: #b85c38;
  color: #fff8ed;
  font-size: 28rpx;
  font-weight: 900;
}

.preview-title {
  color: #2d2822;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.preview-desc {
  margin-top: 8rpx;
  color: #7c7164;
  font-size: 24rpx;
  line-height: 1.55;
}

.preview-metrics,
.stats-card {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.preview-metrics {
  margin-top: 30rpx;
  padding-top: 26rpx;
  border-top: 1rpx dashed rgba(120, 98, 72, 0.18);
}

.preview-metrics view,
.stat-item {
  flex: 1;
  text-align: center;
}

.metric-num,
.num {
  color: #2d2822;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1;
}

.metric-label,
.unit,
.stat-label {
  color: #7c7164;
  font-size: 22rpx;
  font-weight: 800;
}

.auth-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 36rpx;
}

.user-card {
  gap: 28rpx;
}

.avatar-box {
  width: 124rpx;
  height: 124rpx;
  flex-shrink: 0;
  overflow: hidden;
  border: 8rpx solid rgba(255, 251, 243, 0.92);
  border-radius: 50%;
  box-shadow: 0 12rpx 28rpx rgba(69, 47, 26, 0.12);
}

.profile-avatar {
  width: 100%;
  height: 100%;
}

.avatar-text-fallback,
.avatar-text-fallback-small {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #5c8f75;
  color: #fff8ed;
  font-weight: 900;
}

.avatar-text-fallback {
  font-size: 42rpx;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.nickname-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.nickname {
  color: #2d2822;
  font-size: 36rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nickname-edit-icon {
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1rpx solid rgba(120, 98, 72, 0.18);
  border-radius: 18rpx;
  background: #fff8ed;
  color: #7c7164;
  font-size: 26rpx;
  font-weight: 900;
}

.join-days {
  margin-top: 8rpx;
  color: #7c7164;
  font-size: 24rpx;
  font-weight: 800;
}

.join-code-row {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(92, 143, 117, 0.1);
}

.join-code-label,
.join-code-copy {
  color: #4f7b65;
  font-size: 21rpx;
  font-weight: 900;
}

.join-code-value {
  color: #2d2822;
  font-size: 24rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.partner-card {
  justify-content: space-between;
  gap: 20rpx;
}

.partner-info {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}

.partner-avatar-small {
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  border-radius: 50%;
}

.avatar-text-fallback-small {
  background: #b85c38;
  font-size: 28rpx;
}

.partner-detail {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.partner-label {
  color: #7c7164;
  font-size: 22rpx;
  font-weight: 800;
}

.partner-name {
  margin-top: 6rpx;
  color: #2d2822;
  font-size: 28rpx;
  font-weight: 900;
}

.status-tag-mini {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(92, 143, 117, 0.12);
  color: #4f7b65;
  font-size: 22rpx;
  font-weight: 900;
}

.stats-card {
  padding: 30rpx 20rpx;
}

.stat-value {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 4rpx;
  margin-bottom: 10rpx;
}

.goal-header {
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.goal-title {
  color: #2d2822;
  font-size: 32rpx;
  font-weight: 900;
}

.goal-subtitle {
  margin-top: 6rpx;
  color: #7c7164;
  font-size: 23rpx;
  font-weight: 800;
}

.goal-link {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(92, 143, 117, 0.12);
  color: #4f7b65;
  font-size: 23rpx;
  font-weight: 900;
}

.goal-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
  color: #6e6255;
  font-size: 24rpx;
  font-weight: 800;
}

.goal-track {
  height: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(124, 113, 100, 0.14);
}

.goal-track.last {
  margin-bottom: 0;
}

.goal-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #5c8f75;
}

.goal-fill.day {
  background: #b85c38;
}

.settings-card {
  padding: 0;
  overflow: hidden;
}

.setting-item {
  justify-content: space-between;
  padding: 30rpx 34rpx;
  border-bottom: 1rpx solid rgba(120, 98, 72, 0.1);
}

.setting-item.no-border {
  border-bottom: none;
}

.setting-text {
  color: #2d2822;
  font-size: 29rpx;
  font-weight: 900;
}

.setting-text-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.setting-badge {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(184, 92, 56, 0.12);
  color: #a54f33;
  font-size: 20rpx;
  font-weight: 900;
}

.setting-desc {
  margin-top: 8rpx;
  color: #7c7164;
  font-size: 23rpx;
  font-weight: 800;
}

.arrow-right {
  width: 18rpx;
  height: 18rpx;
  flex-shrink: 0;
  border-top: 4rpx solid #b6aa9a;
  border-right: 4rpx solid #b6aa9a;
  transform: rotate(45deg);
}

.logout-btn {
  height: 92rpx;
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 30rpx;
  background: rgba(255, 251, 243, 0.62);
  color: #a75b4a;
  font-size: 26rpx;
  font-weight: 900;
}

.nickname-editor-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(45, 40, 34, 0.45);
  box-sizing: border-box;
}

.nickname-editor {
  width: 100%;
  padding: 34rpx;
  border-radius: 36rpx;
  background: #fffbf3;
  box-sizing: border-box;
}

.nickname-editor-title {
  margin-bottom: 22rpx;
  color: #2d2822;
  font-size: 32rpx;
  font-weight: 900;
}

.nickname-editor-input {
  min-height: 108rpx;
  margin-top: 18rpx;
  padding: 28rpx 26rpx;
  border: 1rpx solid rgba(120, 98, 72, 0.16);
  border-radius: 26rpx;
  background: #fbf7ef;
  color: #2d2822;
  font-size: 30rpx;
  line-height: 44rpx;
  box-sizing: border-box;
}

.nickname-editor-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.nickname-editor-cancel,
.nickname-editor-save {
  flex: 1;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.nickname-editor-cancel {
  background: rgba(124, 113, 100, 0.1);
  color: #7c7164;
}

.nickname-editor-save {
  background: #5c8f75;
  color: #fff8ed;
}

.review-login-modal {
  background: #fffbf3;
}

.review-login-desc {
  margin: -8rpx 0 8rpx;
  color: #7c7164;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.55;
}
