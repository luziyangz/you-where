<view class="profile-page">
  <view class="page-orb"></view>

  <block wx:if="{{!isLogin}}">
    <view class="login-state">
      <view class="eyebrow">我的共读资产</view>
      <view class="hero-title">登录后，保存你们慢慢读过的痕迹</view>
      <view class="hero-desc">这里不是第二个首页，只放你的资料、共读资产、目标、历史和提醒。</view>

      <view class="login-preview">
        <view class="preview-row">
          <view class="preview-seal">我</view>
          <view>
            <view class="preview-title">共读记录会跟随账号保存</view>
            <view class="preview-desc">退出后不会删除云端数据，重新登录即可继续。</view>
          </view>
        </view>
        <view class="preview-metrics">
          <view>
            <text class="metric-num">0</text>
            <text class="metric-label">本书</text>
          </view>
          <view>
            <text class="metric-num">0</text>
            <text class="metric-label">条记录</text>
          </view>
          <view>
            <text class="metric-num">--</text>
            <text class="metric-label">共读码</text>
          </view>
        </view>
      </view>

      <login-consent-panel bind:statuschange="onLoginConsentChange" />
      <view class="auth-actions">
        <button
          class="btn-primary w-full"
          loading="{{loginLoading}}"
          disabled="{{!canProceedLogin || loginLoading}}"
          bindtap="onTapLogin"
        >保存进度前登录</button>
        <button
          wx:if="{{showReviewLogin}}"
          class="btn-review-login w-full"
          disabled="{{!canProceedLogin || reviewLoginLoading}}"
          bindtap="onOpenReviewLogin"
        >审核测试登录</button>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="page-head">
      <view>
        <view class="eyebrow">我的</view>
        <view class="page-title">共读资产</view>
        <view class="page-desc">个人资料、目标和历史都放在这里，不打断你们正在读的那本书。</view>
      </view>
      <view class="asset-chip">
        <text>{{stats.total_books || 0}}</text>
        <text>本</text>
      </view>
    </view>

    <view class="user-card">
      <view class="avatar-box">
        <block wx:if="{{user.avatar}}">
          <image class="profile-avatar" src="{{user.avatar}}" mode="aspectFill"></image>
        </block>
        <block wx:else>
          <view class="profile-avatar avatar-text-fallback">{{userInitial}}</view>
        </block>
      </view>
      <view class="user-info">
        <view class="nickname-row">
          <view class="nickname">{{user.nickname || '用户'}}</view>
          <view class="nickname-edit-icon" bindtap="onTapEditNickname">✎</view>
        </view>
        <view class="join-days">加入共读的第 {{user.join_days || 1}} 天</view>
        <view class="join-code-row" bindtap="onCopyJoinCode">
          <text class="join-code-label">共读码</text>
          <text class="join-code-value">{{user.join_code || '--'}}</text>
          <text class="join-code-copy">复制</text>
        </view>
      </view>
    </view>

    <view class="partner-card" wx:if="{{user.partner}}">
      <view class="partner-info">
        <block wx:if="{{user.partner.avatar}}">
          <image class="partner-avatar-small" src="{{user.partner.avatar}}" mode="aspectFill"></image>
        </block>
        <block wx:else>
          <view class="partner-avatar-small avatar-text-fallback-small">{{partnerInitial}}</view>
        </block>
        <view class="partner-detail">
          <text class="partner-label">我的共读伙伴</text>
          <text class="partner-name">{{user.partner.nickname}}</text>
        </view>
      </view>
      <view class="status-tag-mini">共读中</view>
    </view>

    <view class="stats-card">
      <view class="stat-item">
        <view class="stat-value">
          <text class="num">{{stats.total_days || 1}}</text>
          <text class="unit">天</text>
        </view>
        <view class="stat-label">共读天数</view>
      </view>
      <view class="stat-item">
        <view class="stat-value">
          <text class="num">{{stats.total_books || 0}}</text>
          <text class="unit">本</text>
        </view>
        <view class="stat-label">已读完</view>
      </view>
      <view class="stat-item">
        <view class="stat-value">
          <text class="num">{{stats.total_entries || 0}}</text>
          <text class="unit">条</text>
        </view>
        <view class="stat-label">累计记录</view>
      </view>
    </view>

    <view class="goal-card">
      <view class="goal-header">
        <view>
          <view class="goal-title">共读目标</view>
          <view class="goal-subtitle">给我们一个轻轻坚持的方向</view>
        </view>
        <view class="goal-link" bindtap="onTapReadingGoal">调整</view>
      </view>
      <view class="goal-row">
        <text>完成书籍</text>
        <text>{{goalProgress.completed_books}} / {{goalProgress.target_books}}</text>
      </view>
      <view class="goal-track">
        <view class="goal-fill" style="width: {{goalProgress.book_percent}}%"></view>
      </view>
      <view class="goal-row">
        <text>打卡天数</text>
        <text>{{goalProgress.active_days}} / {{goalProgress.target_days}}</text>
      </view>
      <view class="goal-track last">
        <view class="goal-fill day" style="width: {{goalProgress.day_percent}}%"></view>
      </view>
    </view>

    <view class="settings-card">
      <view class="setting-item" bindtap="onTapReadingHistory">
        <view>
          <view class="setting-text">阅读历史</view>
          <view class="setting-desc">看你们读完的共同记忆</view>
        </view>
        <view class="arrow-right"></view>
      </view>
      <view class="setting-item" bindtap="onTapReadingGoal">
        <view>
          <view class="setting-text">共读目标</view>
          <view class="setting-desc">调整轻量目标</view>
        </view>
        <view class="arrow-right"></view>
      </view>
      <view class="setting-item" bindtap="onTapReminder">
        <view>
          <view class="setting-text">温柔提醒</view>
          <view class="setting-desc">到点提醒，不制造压力</view>
        </view>
        <view class="arrow-right"></view>
      </view>
      <view class="setting-item no-border" bindtap="onTapSettings">
        <view>
          <view class="setting-text">系统设置</view>
          <view class="setting-desc">协议、隐私和基础设置</view>
        </view>
        <view class="arrow-right"></view>
      </view>
    </view>

    <view class="logout-btn" bindtap="onTapLogout">退出登录</view>

    <view class="nickname-editor-mask" wx:if="{{editingNickname}}" bindtap="onCancelEditNickname">
      <view class="nickname-editor" catchtap="noop">
        <view class="nickname-editor-title">修改昵称</view>
        <input
          class="nickname-editor-input"
          value="{{nicknameDraft}}"
          maxlength="64"
          bindinput="onNicknameInput"
          placeholder="请输入新的昵称"
        />
        <view class="nickname-editor-actions">
          <button class="nickname-editor-cancel" bindtap="onCancelEditNickname">取消</button>
          <button class="nickname-editor-save" loading="{{savingNickname}}" bindtap="onSaveNickname">保存</button>
        </view>
      </view>
    </view>
  </block>

  <view class="nickname-editor-mask" wx:if="{{showReviewLoginPanel}}" bindtap="onCloseReviewLogin">
    <view class="nickname-editor review-login-modal" catchtap="noop">
      <view class="nickname-editor-title">审核测试登录</view>
      <view class="review-login-desc">仅供微信审核使用，正式版不会显示此入口。</view>
      <input
        class="nickname-editor-input"
        value="{{reviewAccount}}"
        maxlength="64"
        bindinput="onReviewAccountInput"
        placeholder="审核账号"
      />
      <input
        class="nickname-editor-input"
        password
        value="{{reviewPassword}}"
        maxlength="128"
        bindinput="onReviewPasswordInput"
        placeholder="审核密码"
      />
      <view class="nickname-editor-actions">
        <button class="nickname-editor-cancel" bindtap="onCloseReviewLogin">取消</button>
        <button class="nickname-editor-save" loading="{{reviewLoginLoading}}" bindtap="onSubmitReviewLogin">登录</button>
      </view>
    </view>
  </view>
</view>
