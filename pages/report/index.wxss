.report-page {
  min-height: 100vh;
  background: #f5f7fb;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
}

.desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #6b7280;
}

.target-box {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f9fafb;
}

.target-label {
  font-size: 22rpx;
  color: #9ca3af;
}

.target-text {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #374151;
  font-weight: 600;
}

.target-preview {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6b7280;
}

.section-title {
  margin-top: 28rpx;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.reason-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.reason-item {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #4b5563;
  background: #f3f4f6;
}

.reason-item.is-active {
  color: #fff;
  background: #2d2822;
}

.desc-input {
  width: 100%;
  min-height: 180rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #f9fafb;
  font-size: 26rpx;
  line-height: 1.6;
}

.submit-btn {
  margin-top: 28rpx;
  background: #2d2822;
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.submit-btn[disabled] {
  opacity: 0.45;
}

.contact-box {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f3f4f6;
}

.contact-title {
  font-size: 24rpx;
  color: #6b7280;
}

.contact-row {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  color: #374151;
}

.copy-link {
  color: #2563eb;
}

.contact-time {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9ca3af;
}
