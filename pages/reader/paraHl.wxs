/* 段落划重点：storage 使用字符串 key，与段落 index 对齐 */
function getRow(map, idx) {
  if (!map) {
    return null;
  }
  var s = '' + idx;
  return map[s] || map[idx] || null;
}

function style(map, idx) {
  var row = getRow(map, idx);
  return row && row.style ? row.style : '';
}

function note(map, idx) {
  var row = getRow(map, idx);
  return row && row.note ? row.note : '';
}

function hasNote(map, idx) {
  return note(map, idx).length > 0;
}

module.exports = {
  style: style,
  note: note,
  hasNote: hasNote
};
