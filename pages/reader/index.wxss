.reader-page {
  height: 100vh;
  max-height: 100vh;
  padding: 0;
  box-sizing: border-box;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: linear-gradient(165deg, #faf3e8 0%, #f0e4d4 42%, #ebe0d0 100%);
  color: #3d342c;
}

.reader-page.mode-night {
  background: linear-gradient(180deg, #1c1916 0%, #151311 100%);
  color: #ece4d9;
}

.reader-page.mode-focus {
  background: linear-gradient(180deg, #fff9f0 0%, #f5ebe0 100%);
}

.reader-card,
.reader-shell {
  flex: 1;
  min-height: 0;
  display: flex;
  position: relative;
  flex-direction: column;
  border: none;
  border-radius: 0;
  background:
    linear-gradient(90deg, rgba(193, 127, 99, 0.06) 0, transparent 18rpx, transparent calc(100% - 18rpx), rgba(92, 143, 117, 0.05) 100%),
    #fdf6eb;
  box-shadow: none;
  overflow: hidden;
}

.reader-shell--warm .reader-paper-texture {
  pointer-events: none;
  position: absolute;
  inset: 0;
  z-index: 1;
  opacity: 0.35;
  background-image:
    radial-gradient(circle at 12% 18%, rgba(193, 127, 99, 0.07), transparent 42%),
    radial-gradient(circle at 88% 8%, rgba(92, 143, 117, 0.06), transparent 38%),
    radial-gradient(circle at 50% 100%, rgba(184, 92, 56, 0.05), transparent 45%);
}

.brightness-mask {
  pointer-events: none;
  position: absolute;
  inset: 0;
  z-index: 2;
  background: #000;
}

.cache-hint {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  top: 28rpx;
  z-index: 13;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(61, 52, 44, 0.72);
  color: #fff8ed;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
  pointer-events: none;
}

/* 仅用于文本测量，不参与布局 */
.reader-measure-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 8px;
  height: 8px;
  opacity: 0;
  pointer-events: none;
}

.mode-night .reader-card,
.mode-night .reader-shell {
  border-color: rgba(232, 220, 203, 0.12);
  background: #211e1a;
  box-shadow: none;
}

.mode-focus .reader-shell {
  background: #fffaf3;
}

.loading-card,
.reader-card {
  justify-content: center;
  padding: 42rpx;
  box-sizing: border-box;
}

.loading-heart {
  font-size: 56rpx;
  text-align: center;
  margin-bottom: 18rpx;
  color: #c17f63;
  opacity: 0.85;
  animation: heart-soft 1.6s ease-in-out infinite;
}

@keyframes heart-soft {
  0%,
  100% {
    transform: scale(1);
    opacity: 0.75;
  }
  50% {
    transform: scale(1.06);
    opacity: 1;
  }
}

.title {
  color: inherit;
  font-size: 34rpx;
  font-weight: 900;
}

.desc {
  margin-top: 14rpx;
  color: #7c7164;
  font-size: 25rpx;
  line-height: 1.6;
}

.mode-night .desc {
  color: #aaa094;
}

.reader-top {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 12;
  min-height: 132rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 66rpx 30rpx 18rpx;
  background: rgba(255, 248, 238, 0.94);
  backdrop-filter: blur(12px);
  box-shadow: 0 10rpx 36rpx rgba(93, 62, 48, 0.07);
  box-sizing: border-box;
}

.mode-night .reader-top {
  background: rgba(33, 30, 26, 0.96);
}

.top-back {
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: inherit;
  font-size: 52rpx;
  line-height: 1;
}

.book-title {
  color: inherit;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.35;
}

.book-author {
  margin-top: 8rpx;
  color: #7c7164;
  font-size: 23rpx;
  font-weight: 800;
}

.mode-night .book-author {
  color: #aaa094;
}

.tool-buttons {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.tool-btn {
  min-width: 72rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: rgba(193, 127, 99, 0.14);
  color: #a0523d;
  font-size: 23rpx;
  font-weight: 900;
}

.tool-btn-soft {
  background: rgba(92, 143, 117, 0.12);
  color: #4f7b65;
}

.mode-night .tool-btn {
  background: rgba(232, 220, 203, 0.1);
  color: #e8dccb;
}

.mode-night .tool-btn-soft {
  background: rgba(147, 175, 154, 0.15);
  color: #c5d9c8;
}

.reader-meta-bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx 20rpx;
  padding-bottom: 14rpx;
  margin-bottom: 6rpx;
  border-bottom: 1rpx solid rgba(193, 127, 99, 0.14);
  color: #8a7d6e;
  font-size: 22rpx;
  font-weight: 800;
}

.reader-meta-main {
  flex: 1 1 auto;
  min-width: 0;
  color: #4f7b65;
  font-weight: 900;
}

.reader-meta-sub {
  font-size: 21rpx;
  font-weight: 700;
  color: #9a8b7c;
}

.mode-night .reader-meta-bar {
  border-bottom-color: rgba(232, 220, 203, 0.1);
  color: #9f9588;
}

.mode-night .reader-meta-main {
  color: #93af9a;
}

.mode-night .reader-meta-sub {
  color: #aaa094;
}

.reader-meta-extra {
  margin-left: auto;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(92, 143, 117, 0.12);
  color: #4f7b65;
  font-size: 21rpx;
  font-weight: 800;
}

.mode-night .reader-meta-extra {
  background: rgba(147, 175, 154, 0.15);
  color: #c5d9c8;
}

.reader-content {
  position: relative;
  z-index: 3;
  flex: 1;
  min-height: 0;
  padding: calc(16rpx + env(safe-area-inset-top)) 50rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: hidden;
}

/* 顶栏显示时为正文留出空间，避免被遮挡 */
.reader-shell.controls-on .reader-content {
  padding-top: calc(148rpx + env(safe-area-inset-top));
}

/* 段落外层：划重点样式与备注角标 */
.paragraph-wrap {
  position: relative;
  margin-bottom: 28rpx;
  padding: 4rpx 6rpx;
  margin-left: -6rpx;
  margin-right: -6rpx;
  border-radius: 12rpx;
  transition: background 0.18s ease, box-shadow 0.18s ease;
}

.reader-content .paragraph-wrap .paragraph {
  margin-bottom: 0;
}

.reader-content .paragraph-wrap .paragraph.para-gap-before {
  margin-top: 28rpx;
}

.paragraph {
  position: relative;
  color: inherit;
  line-height: 1.95;
  letter-spacing: 1rpx;
  text-align: justify;
  word-break: break-word;
}

.paragraph-wrap.hl-marker {
  background: linear-gradient(transparent 52%, rgba(240, 196, 140, 0.42) 52%);
  box-shadow: inset 0 0 0 1rpx rgba(193, 127, 99, 0.08);
}

.paragraph-wrap.hl-underline .paragraph {
  border-bottom: 2rpx solid rgba(193, 127, 99, 0.38);
  padding-bottom: 4rpx;
}

.paragraph-wrap.hl-has-note.hl-marker {
  background: linear-gradient(transparent 52%, rgba(232, 200, 168, 0.48) 52%);
}

.mode-night .paragraph-wrap.hl-marker {
  background: linear-gradient(transparent 52%, rgba(184, 92, 56, 0.35) 52%);
  box-shadow: inset 0 0 0 1rpx rgba(232, 220, 203, 0.06);
}

.mode-night .paragraph-wrap.hl-underline .paragraph {
  border-bottom-color: rgba(232, 200, 180, 0.35);
}

.para-note-badge {
  position: absolute;
  right: 0;
  top: -6rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 900;
  color: #fff8ed;
  background: linear-gradient(135deg, #c17f63, #a0523d);
  box-shadow: 0 4rpx 12rpx rgba(160, 82, 61, 0.25);
  z-index: 2;
}

.para-note-body {
  margin-top: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(193, 127, 99, 0.1);
  border-left: 4rpx solid rgba(193, 127, 99, 0.45);
}

.para-note-text {
  display: block;
  color: #6b4a38;
  font-size: 24rpx;
  line-height: 1.65;
}

.mode-night .para-note-body {
  background: rgba(184, 92, 56, 0.16);
  border-left-color: rgba(232, 200, 180, 0.35);
}

.mode-night .para-note-text {
  color: #e8dcc8;
}

.quote-journal-preview {
  margin: 20rpx 0 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(92, 143, 117, 0.1);
  border: 1rpx solid rgba(92, 143, 117, 0.16);
}

.quote-journal-label {
  color: #4f7b65;
  font-size: 22rpx;
  font-weight: 900;
}

.quote-journal-text {
  display: block;
  margin-top: 10rpx;
  color: #2d2822;
  font-size: 26rpx;
  line-height: 1.65;
}

.mode-night .quote-journal-text {
  color: #e8dcc8;
}

.mode-night .para-note-badge {
  background: linear-gradient(135deg, #8f5e4a, #6e4638);
}

.reader-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 12;
  min-height: 280rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(193, 127, 99, 0.14);
  background: rgba(255, 248, 238, 0.96);
  backdrop-filter: blur(12px);
  box-shadow: 0 -14rpx 40rpx rgba(93, 62, 48, 0.08);
  box-sizing: border-box;
}

.mode-night .reader-bottom {
  border-top-color: rgba(232, 220, 203, 0.1);
  background: rgba(33, 30, 26, 0.96);
}

.progress-slider,
.brightness-slider {
  width: 100%;
  margin: 0;
}

.progress-line {
  display: grid;
  grid-template-columns: 54rpx 1fr 54rpx;
  align-items: center;
  gap: 18rpx;
  color: #8a7d6e;
  font-size: 22rpx;
  font-weight: 900;
}

.progress-track-mini {
  height: 8rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(124, 113, 100, 0.18);
}

.progress-fill-mini {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #7daf92, #c17f63);
}

.bottom-actions {
  display: grid;
  grid-template-columns: 1fr 1.25fr 1fr;
  gap: 14rpx;
}

.bottom-tools {
  display: flex;
  justify-content: center;
  gap: 54rpx;
  color: #6e6255;
  font-size: 25rpx;
  font-weight: 900;
}

.mode-night .bottom-tools {
  color: #d8cbbb;
}

.nav-btn,
.sync-btn {
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  font-size: 26rpx;
  font-weight: 900;
}

.nav-btn {
  background: rgba(124, 113, 100, 0.1);
  color: #6e6255;
}

.sync-btn {
  background: linear-gradient(135deg, #5c8f75 0%, #4d7a62 55%, #c17f63 160%);
  color: #fff8ed;
  box-shadow: 0 10rpx 26rpx rgba(92, 143, 117, 0.28);
}

.mode-night .nav-btn {
  background: rgba(232, 220, 203, 0.1);
  color: #d8cbbb;
}

.reader-panel {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 320rpx;
  z-index: 20;
  max-height: 62vh;
  padding: 30rpx;
  border: 1rpx solid rgba(120, 98, 72, 0.16);
  border-radius: 34rpx;
  background: rgba(255, 251, 243, 0.98);
  box-shadow: 0 20rpx 56rpx rgba(69, 47, 26, 0.18);
  box-sizing: border-box;
}

.catalog-panel {
  left: 24rpx;
  right: auto;
  top: 148rpx;
  bottom: 320rpx;
  width: 78vw;
  max-height: none;
}

.mode-night .reader-panel {
  border-color: rgba(232, 220, 203, 0.12);
  background: #211e1a;
}

.panel-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.panel-tab {
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: rgba(124, 113, 100, 0.1);
  color: #6e6255;
  font-size: 24rpx;
  font-weight: 900;
}

.panel-tab.active {
  background: linear-gradient(135deg, #c17f63, #a0523d);
  color: #fff8ed;
  box-shadow: 0 8rpx 20rpx rgba(160, 82, 61, 0.22);
}

.panel-title {
  margin-bottom: 20rpx;
  color: inherit;
  font-size: 30rpx;
  font-weight: 900;
}

.catalog-list {
  max-height: calc(100vh - 240rpx);
}

.catalog-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(120, 98, 72, 0.1);
  color: #6e6255;
  font-size: 25rpx;
  font-weight: 800;
}

.catalog-item.active {
  color: #4f7b65;
}

.mode-night .catalog-item {
  border-bottom-color: rgba(232, 220, 203, 0.1);
  color: #d8cbbb;
}

.empty-hints {
  padding: 22rpx 0;
  color: #8a7d6e;
  font-size: 23rpx;
  font-weight: 800;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 26rpx;
  color: inherit;
  font-size: 26rpx;
  font-weight: 900;
}

.font-tools {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.font-tools button {
  width: 82rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: rgba(92, 143, 117, 0.12);
  color: #4f7b65;
  font-size: 24rpx;
  font-weight: 900;
}

.mode-row {
  display: flex;
  gap: 14rpx;
}

.mode-chip {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: rgba(124, 113, 100, 0.1);
  color: #6e6255;
  font-size: 25rpx;
  font-weight: 900;
}

.mode-chip.active {
  background: linear-gradient(135deg, #7daf92, #5c8f75);
  color: #fff8ed;
}

.brightness-row {
  margin-top: 20rpx;
  margin-bottom: 10rpx;
}

.catalog-item--hl {
  flex-direction: column;
  align-items: stretch;
  gap: 10rpx;
}

.hl-item-main {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  width: 100%;
}

.hl-item-tag {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(193, 127, 99, 0.14);
  color: #a0523d;
  font-size: 20rpx;
  font-weight: 900;
}

.hl-item-preview {
  flex: 1;
  min-width: 0;
  color: #4a4038;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.45;
}

.hl-item-note {
  font-size: 22rpx;
  font-weight: 700;
  color: #5c8f75;
  line-height: 1.55;
}

.hl-item-page {
  align-self: flex-end;
  font-size: 21rpx;
  color: #9a8b7c;
  font-weight: 700;
}

.mode-night .hl-item-preview {
  color: #d8cbbb;
}

.mode-night .hl-item-note {
  color: #a3c4af;
}

.note-popup-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  background: rgba(61, 52, 44, 0.42);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.note-popup-sheet {
  width: 100%;
  max-width: 680rpx;
  padding: 34rpx 28rpx 28rpx;
  border-radius: 36rpx 36rpx 28rpx 28rpx;
  background: linear-gradient(180deg, #fffdf9 0%, #fdf6eb 100%);
  border: 1rpx solid rgba(193, 127, 99, 0.18);
  box-shadow: 0 -20rpx 60rpx rgba(93, 62, 48, 0.15);
  box-sizing: border-box;
}

.note-popup-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #3d342c;
}

.note-popup-desc {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #8a7d6e;
  line-height: 1.55;
}

.note-style-row {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
}

.note-style-chip {
  flex: 1;
  text-align: center;
  padding: 16rpx 12rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 900;
  color: #6e6255;
  background: rgba(124, 113, 100, 0.08);
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.note-style-chip.on {
  border-color: rgba(193, 127, 99, 0.45);
  background: rgba(193, 127, 99, 0.1);
  color: #a0523d;
}

.note-popup-input {
  margin-top: 20rpx;
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 251, 243, 0.95);
  border: 1rpx solid rgba(120, 98, 72, 0.14);
  font-size: 26rpx;
  color: #3d342c;
  line-height: 1.55;
  box-sizing: border-box;
}

.note-ph {
  color: #b5a89a;
}

.note-popup-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
}

.note-btn-cancel,
.note-btn-ok {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 900;
  margin: 0;
  padding: 0;
}

.note-btn-cancel {
  background: rgba(124, 113, 100, 0.1);
  color: #6e6255;
}

.note-btn-ok {
  background: linear-gradient(135deg, #c17f63, #a0523d);
  color: #fff8ed;
}

.note-btn-cancel::after,
.note-btn-ok::after {
  border: none;
}

.mode-night .note-popup-sheet {
  background: linear-gradient(180deg, #2f2b26 0%, #262320 100%);
  border-color: rgba(232, 220, 203, 0.12);
}

.mode-night .note-popup-title {
  color: #ece4d9;
}

.mode-night .note-popup-desc {
  color: #aaa094;
}

.mode-night .note-popup-input {
  background: #211e1a;
  border-color: rgba(232, 220, 203, 0.12);
  color: #ece4d9;
}

.mode-night .note-style-chip {
  color: #d8cbbb;
  background: rgba(232, 220, 203, 0.06);
}

.mode-night .note-style-chip.on {
  border-color: rgba(232, 200, 180, 0.35);
  background: rgba(184, 92, 56, 0.15);
  color: #f0e4d8;
}

.turn-next .reader-content,
.turn-prev .reader-content {
  animation: pageTurn 0.24s ease;
}

@keyframes pageTurn {
  0% {
    opacity: 0.35;
    transform: translateX(18rpx);
  }
  100% {
    opacity: 1;
    transform: translateX(0);
  }
}
