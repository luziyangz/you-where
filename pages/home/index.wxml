<view class="home-page {{(!isLogin || !hasPartner) ? 'is-centered' : ''}}">
  <view class="home-bg">
    <view class="grain-dot dot-a"></view>
    <view class="grain-dot dot-b"></view>
  </view>

  <block wx:if="{{!isLogin}}">
    <view class="state-wrap login-state">
      <view class="eyebrow">双人共读书房</view>
      <view class="hero-title">和重要的人，一起读完一本书</view>
      <view class="hero-desc">登录后生成你的共读码，邀请伴侣或朋友建立只属于两个人的阅读关系。</view>

      <view class="preview-card">
        <view class="preview-top">
          <view class="seal">共读</view>
          <view class="preview-copy">今日书房还未开启</view>
        </view>
        <view class="duo-row">
          <view class="duo-person">
            <view class="duo-avatar me">我</view>
            <view class="duo-name">你</view>
          </view>
          <view class="duo-line">
            <view class="duo-line-inner"></view>
          </view>
          <view class="duo-person">
            <view class="duo-avatar partner">TA</view>
            <view class="duo-name">伙伴</view>
          </view>
        </view>
        <view class="topic-chips">
          <text>心性共修</text>
          <text>国学经典</text>
          <text>经络养生</text>
        </view>
      </view>

      <login-consent-panel bind:statuschange="onLoginConsentChange" />
      <view class="auth-actions">
        <button
          class="btn-primary w-full"
          loading="{{loginLoading}}"
          disabled="{{!canProceedLogin || loginLoading}}"
          bindtap="onTapLogin"
        >微信一键登录</button>
        <button
          wx:if="{{showReviewLogin}}"
          class="btn-review-login w-full"
          disabled="{{!canProceedLogin || reviewLoginLoading}}"
          bindtap="onOpenReviewLogin"
        >审核测试登录</button>
      </view>
    </view>
  </block>

  <block wx:elif="{{isLogin && !hasPartner}}">
    <view class="state-wrap bind-state">
      <view class="eyebrow">等待连接</view>
      <view class="hero-title">还差一个共读伙伴</view>
      <view class="hero-desc">把你的共读码或二维码发给对方，绑定后首页会变成你们共同的阅读面板。</view>

      <view class="relation-card">
        <view class="relation-person">
          <view class="avatar-ring me">
            <block wx:if="{{user.avatar}}">
              <image src="{{user.avatar}}" mode="aspectFill"></image>
            </block>
            <block wx:else>{{userInitial}}</block>
          </view>
          <view class="person-name">{{user.nickname || '我'}}</view>
        </view>
        <view class="relation-knot is-waiting">
          <view class="knot-dot"></view>
          <view class="knot-line"></view>
          <view class="knot-dot"></view>
        </view>
        <view class="relation-person">
          <view class="avatar-ring partner empty">待绑定</view>
          <view class="person-name muted">伙伴</view>
        </view>
      </view>

      <view class="code-hint" wx:if="{{user.join_code}}">
        <text class="code-label">你的共读码</text>
        <text class="code-value">{{user.join_code}}</text>
      </view>

      <view class="switch-card" wx:if="{{pairRequestIncoming}}">
        <view class="switch-title">{{pairRequestTitle}}</view>
        <view class="switch-desc">{{pairRequestSub}}</view>
        <view class="switch-actions">
          <button class="switch-btn reject" loading="{{pairRequestResponding}}" bindtap="onRejectPairRequest">拒绝</button>
          <button class="switch-btn approve" loading="{{pairRequestResponding}}" bindtap="onApprovePairRequest">同意</button>
        </view>
      </view>
      <view class="switch-card switch-card--out" wx:elif="{{pairRequestOutgoing}}">
        <view class="switch-title">{{pairRequestTitle}}</view>
        <view class="switch-desc">{{pairRequestSub}}</view>
      </view>

      <button class="btn-primary w-full" bindtap="onGoToPartner">去邀请伙伴</button>
      <button class="btn-plain w-full" bindtap="onGoToBookstore">先看看主题书房</button>
    </view>
  </block>

  <block wx:elif="{{hasPartner && !currentBook}}">
    <view class="content-wrap">
      <view class="section-hero">
        <view>
          <view class="eyebrow">关系已建立</view>
          <view class="page-title">选择你们的第一本书</view>
        </view>
        <view class="mini-seal">二人</view>
      </view>

      <view class="relation-card active">
        <view class="relation-person">
          <view class="avatar-ring me">
            <block wx:if="{{user.avatar}}">
              <image src="{{user.avatar}}" mode="aspectFill"></image>
            </block>
            <block wx:else>{{userInitial}}</block>
          </view>
          <view class="person-name">{{user.nickname || '我'}}</view>
        </view>
        <view class="relation-knot">
          <view class="knot-dot"></view>
          <view class="knot-line"></view>
          <view class="knot-dot"></view>
        </view>
        <view class="relation-person">
          <view class="avatar-ring partner">
            <block wx:if="{{partner.avatar}}">
              <image src="{{partner.avatar}}" mode="aspectFill"></image>
            </block>
            <block wx:else>{{partnerInitial}}</block>
          </view>
          <view class="person-name">{{partner.nickname || '伙伴'}}</view>
        </view>
      </view>

      <view class="switch-card" wx:if="{{pairRequestIncoming}}">
        <view class="switch-title">{{pairRequestTitle}}</view>
        <view class="switch-desc">{{pairRequestSub}}</view>
        <view class="switch-actions">
          <button class="switch-btn reject" loading="{{pairRequestResponding}}" bindtap="onRejectPairRequest">拒绝</button>
          <button class="switch-btn approve" loading="{{pairRequestResponding}}" bindtap="onApprovePairRequest">同意</button>
        </view>
      </view>
      <view class="switch-card switch-card--out" wx:elif="{{pairRequestOutgoing}}">
        <view class="switch-title">{{pairRequestTitle}}</view>
        <view class="switch-desc">{{pairRequestSub}}</view>
      </view>

      <view class="switch-card" wx:if="{{bookSwitchIncoming}}">
        <view class="switch-title">伙伴申请加入/换书</view>
        <view class="switch-desc" wx:if="{{bookSwitchIncoming.from_book && bookSwitchIncoming.from_book.title}}">《{{bookSwitchIncoming.title}}》 · 替换《{{bookSwitchIncoming.from_book.title}}》</view>
        <view class="switch-desc" wx:else>《{{bookSwitchIncoming.title}}》</view>
        <view class="switch-actions">
          <button class="switch-btn reject" loading="{{switchResponding}}" bindtap="onRejectBookSwitch">拒绝</button>
          <button class="switch-btn approve" loading="{{switchResponding}}" bindtap="onApproveBookSwitch">同意</button>
        </view>
      </view>
      <view class="switch-card switch-card--out" wx:elif="{{bookSwitchOutgoing}}">
        <view class="switch-title">加入共读申请中</view>
        <view class="switch-desc">《{{bookSwitchOutgoing.title}}》等待 {{partner.nickname || '伙伴'}} 同意</view>
      </view>

      <view class="empty-book-card">
        <view class="book-stack">
          <view class="book-spine one"></view>
          <view class="book-spine two"></view>
          <view class="book-spine three"></view>
        </view>
        <view class="empty-title">书桌已经摆好</view>
        <view class="empty-desc">从主题书房选一本中文内容，或手动添加你们正在读的书。</view>
        <button class="btn-primary w-full" bindtap="onGoToBookstore">去主题书房选书</button>
        <button class="btn-secondary w-full" bindtap="onTapAddBook">手动添加一本</button>
        <view class="text-link" bindtap="onGoManagePartner">管理伙伴关系</view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="content-wrap">
      <view class="switch-card" wx:if="{{pairRequestIncoming}}">
        <view class="switch-title">{{pairRequestTitle}}</view>
        <view class="switch-desc">{{pairRequestSub}}</view>
        <view class="switch-actions">
          <button class="switch-btn reject" loading="{{pairRequestResponding}}" bindtap="onRejectPairRequest">拒绝</button>
          <button class="switch-btn approve" loading="{{pairRequestResponding}}" bindtap="onApprovePairRequest">同意</button>
        </view>
      </view>
      <view class="switch-card switch-card--out" wx:elif="{{pairRequestOutgoing}}">
        <view class="switch-title">{{pairRequestTitle}}</view>
        <view class="switch-desc">{{pairRequestSub}}</view>
      </view>

      <view class="switch-card" wx:if="{{bookSwitchIncoming}}">
        <view class="switch-title">伙伴申请加入/换书</view>
        <view class="switch-desc" wx:if="{{bookSwitchIncoming.from_book && bookSwitchIncoming.from_book.title}}">《{{bookSwitchIncoming.title}}》 · 替换《{{bookSwitchIncoming.from_book.title}}》</view>
        <view class="switch-desc" wx:else>《{{bookSwitchIncoming.title}}》</view>
        <view class="switch-actions">
          <button class="switch-btn reject" loading="{{switchResponding}}" bindtap="onRejectBookSwitch">拒绝</button>
          <button class="switch-btn approve" loading="{{switchResponding}}" bindtap="onApproveBookSwitch">同意</button>
        </view>
      </view>

      <view class="switch-card switch-card--out" wx:elif="{{bookSwitchOutgoing}}">
        <view class="switch-title">加入共读申请中</view>
        <view class="switch-desc">《{{bookSwitchOutgoing.title}}》等待 {{partner.nickname || '伙伴'}} 同意</view>
      </view>

      <view class="section-hero">
        <view class="section-hero-text tap-open-book" hover-class="tap-open-book--active" bindtap="onOpenCurrentBook">
          <view class="eyebrow">正在共读</view>
          <view class="page-title">{{currentBook.title}}</view>
          <view class="page-subtitle">{{currentBook.author || '作者未填写'}}</view>
        </view>
        <view class="mini-seal">第{{currentBook.reading_days || 1}}天</view>
      </view>

      <view class="today-panel tap-open-book" hover-class="tap-open-book--active" bindtap="onOpenCurrentBook">
        <view class="today-duo">
          <view class="duo-mini">
            <view class="avatar-mini me">
              <block wx:if="{{user.avatar}}">
                <image src="{{user.avatar}}" mode="aspectFill"></image>
              </block>
              <block wx:else>{{userInitial}}</block>
            </view>
            <text class="duo-mini-name">{{user.nickname || '我'}}</text>
          </view>
          <view class="duo-bridge">
            <view class="duo-bridge-line"></view>
            <text class="duo-bridge-text">同读</text>
          </view>
          <view class="duo-mini">
            <view class="avatar-mini partner">
              <block wx:if="{{partner.avatar}}">
                <image src="{{partner.avatar}}" mode="aspectFill"></image>
              </block>
              <block wx:else>{{partnerInitial}}</block>
            </view>
            <text class="duo-mini-name">{{partner.nickname || '伙伴'}}</text>
          </view>
        </view>
        <view class="today-body">
          <view class="book-cover">
            <view class="cover-title">{{currentBook.title}}</view>
            <view class="cover-line"></view>
            <view class="cover-author">{{currentBook.author || '共读书目'}}</view>
          </view>
          <view class="today-copy">
            <view class="reading-label">今日共读 · 第 {{currentBook.reading_days || 1}} 天</view>
            <view class="reading-main">{{currentBook.relationshipTip}}</view>
            <view class="reading-note" wx:if="{{currentBook.total_pages > 0}}">{{currentBook.progressLine}}</view>
            <view class="reading-open-hint" wx:if="{{currentBook.catalog_id}}">轻触打开正文继续读</view>
          </view>
        </view>
      </view>

      <view class="action-card">
        <view class="action-copy">
          <view class="action-title">两个人的共读书桌</view>
          <view class="action-desc">页码、状态和备注保存在「我们的记录」；仅用于已绑定共读关系内的进度同步。</view>
        </view>
        <button class="btn-primary w-full" catchtap="onOpenCurrentBook">继续阅读</button>
        <button class="btn-secondary w-full" bindtap="onGotoProgress">进我们的记录</button>
        <view class="action-links">
          <text class="action-link" bindtap="onGoManagePartner">共读关系</text>
        </view>
      </view>
    </view>
  </block>

  <view class="modal-overlay" wx:if="{{showBookPopup}}" bindtap="onCloseBookPopup">
    <view class="modal-content book-modal" catchtap="noop">
      <view class="modal-header-line"></view>
      <view class="modal-padding">
        <view class="modal-header">
          <text class="modal-title">手动添加共读书</text>
          <view class="close-icon" bindtap="onCloseBookPopup">×</view>
        </view>

        <view class="form-group">
          <input class="form-input" data-field="title" placeholder="书名" value="{{bookForm.title}}" bindinput="onBookFieldInput" />
          <input class="form-input" data-field="author" placeholder="作者（选填）" value="{{bookForm.author}}" bindinput="onBookFieldInput" />
          <input class="form-input" type="number" data-field="total_pages" placeholder="总页数" value="{{bookForm.total_pages}}" bindinput="onBookFieldInput" />
        </view>

        <button class="btn-primary modal-submit" loading="{{bookSubmitting}}" bindtap="onSubmitBook">开始共读</button>
      </view>
    </view>
  </view>

  <view class="modal-overlay" wx:if="{{showReviewLoginPanel}}" bindtap="onCloseReviewLogin">
    <view class="modal-content review-login-modal" catchtap="noop">
      <view class="modal-header-line"></view>
      <view class="modal-padding">
        <view class="modal-header">
          <text class="modal-title">审核测试登录</text>
          <view class="close-icon" bindtap="onCloseReviewLogin">×</view>
        </view>
        <view class="review-login-desc">仅供微信审核使用，正式版不会显示此入口。</view>
        <view class="form-group">
          <input class="form-input" placeholder="审核账号" value="{{reviewAccount}}" bindinput="onReviewAccountInput" />
          <input class="form-input" password placeholder="审核密码" value="{{reviewPassword}}" bindinput="onReviewPasswordInput" />
        </view>
        <button class="btn-primary modal-submit" loading="{{reviewLoginLoading}}" bindtap="onSubmitReviewLogin">登录并进入小程序</button>
      </view>
    </view>
  </view>
</view>
