.home-page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  padding-bottom: 240rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 12% 8%, rgba(184, 92, 56, 0.13), transparent 220rpx),
    linear-gradient(180deg, #fbf6ec 0%, #f3eadb 56%, #efe2cf 100%);
}

.home-page.is-centered {
  min-height: 100vh;
}

.home-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.home-bg::before {
  content: "";
  position: absolute;
  left: -120rpx;
  top: 120rpx;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  background: rgba(92, 143, 117, 0.12);
}

.home-bg::after {
  content: "";
  position: absolute;
  right: -160rpx;
  bottom: 120rpx;
  width: 520rpx;
  height: 520rpx;
  border-radius: 50%;
  background: rgba(184, 92, 56, 0.11);
}

.grain-dot {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(45, 40, 34, 0.14);
  box-shadow:
    92rpx 68rpx 0 rgba(45, 40, 34, 0.08),
    220rpx 18rpx 0 rgba(45, 40, 34, 0.06),
    310rpx 112rpx 0 rgba(45, 40, 34, 0.08);
}

.dot-a {
  left: 96rpx;
  top: 156rpx;
}

.dot-b {
  right: 168rpx;
  bottom: 360rpx;
}

.state-wrap,
.content-wrap {
  position: relative;
  z-index: 1;
  padding: 76rpx 36rpx 0;
  box-sizing: border-box;
}

.state-wrap {
  min-height: calc(100vh - 240rpx);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(184, 92, 56, 0.24);
  border-radius: 999rpx;
  background: rgba(255, 251, 243, 0.72);
  color: #a54f33;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  align-self: flex-start;
}

.hero-title,
.page-title {
  margin-top: 22rpx;
  color: #2d2822;
  font-size: 54rpx;
  font-weight: 900;
  line-height: 1.12;
  letter-spacing: -1rpx;
}

.hero-desc,
.page-subtitle {
  margin-top: 18rpx;
  color: #7c7164;
  font-size: 28rpx;
  line-height: 1.7;
}

.preview-card,
.relation-card,
.empty-book-card,
.reading-card,
.progress-panel,
.action-card {
  margin-top: 42rpx;
  padding: 34rpx;
  border: 1rpx solid rgba(120, 98, 72, 0.16);
  border-radius: 44rpx;
  background: rgba(255, 251, 243, 0.86);
  box-shadow: 0 22rpx 60rpx rgba(69, 47, 26, 0.09);
  box-sizing: border-box;
}

.preview-top,
.section-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.section-hero-text {
  flex: 1;
  min-width: 0;
}

/* 共读书目可点击反馈 */
.tap-open-book--active {
  opacity: 0.88;
}

.seal,
.mini-seal {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #b85c38;
  color: #fff8ed;
  font-size: 24rpx;
  font-weight: 900;
  box-shadow: inset 0 0 0 6rpx rgba(255, 248, 237, 0.22);
}

.mini-seal {
  width: 100rpx;
  height: 100rpx;
  background: #5c8f75;
  text-align: center;
}

.preview-copy {
  flex: 1;
  color: #6e6255;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.5;
}

.duo-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 38rpx;
}

.duo-person,
.relation-person {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 160rpx;
}

.duo-avatar,
.avatar-ring,
.avatar-mini {
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 50%;
  color: #fff8ed;
  font-weight: 900;
}

.duo-avatar,
.avatar-ring {
  width: 112rpx;
  height: 112rpx;
  font-size: 30rpx;
  border: 8rpx solid rgba(255, 251, 243, 0.9);
  box-shadow: 0 12rpx 30rpx rgba(64, 43, 25, 0.12);
}

.duo-avatar.me,
.avatar-ring.me,
.avatar-mini.me {
  background: #5c8f75;
}

.duo-avatar.partner,
.avatar-ring.partner,
.avatar-mini.partner {
  background: #b85c38;
}

.avatar-ring.empty {
  width: 124rpx;
  height: 124rpx;
  border: 2rpx dashed rgba(124, 113, 100, 0.4);
  background: rgba(124, 113, 100, 0.08);
  color: #8a7d6e;
  font-size: 24rpx;
}

.avatar-ring image,
.avatar-mini image {
  width: 100%;
  height: 100%;
  display: block;
}

.duo-name,
.person-name {
  margin-top: 14rpx;
  max-width: 160rpx;
  color: #2d2822;
  font-size: 24rpx;
  font-weight: 800;
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.person-name.muted {
  color: #8a7d6e;
}

.duo-line,
.relation-knot {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 0 10rpx;
}

.duo-line-inner,
.knot-line {
  flex: 1;
  height: 4rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #5c8f75, #b85c38);
}

.relation-knot {
  max-width: 220rpx;
  gap: 8rpx;
}

.relation-knot.is-waiting .knot-line {
  background: linear-gradient(90deg, #5c8f75, rgba(124, 113, 100, 0.2));
}

.knot-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #b85c38;
}

.relation-knot.is-waiting .knot-dot:last-child {
  background: rgba(124, 113, 100, 0.24);
}

.topic-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 34rpx;
}

.topic-chips text {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(92, 143, 117, 0.12);
  color: #4f7b65;
  font-size: 22rpx;
  font-weight: 700;
}

.auth-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 36rpx;
}

.code-hint {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 0 28rpx;
  padding: 22rpx 26rpx;
  border-radius: 28rpx;
  background: rgba(92, 143, 117, 0.1);
}

.code-label {
  color: #6e6255;
  font-size: 24rpx;
  font-weight: 700;
}

.code-value {
  color: #4f7b65;
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.btn-plain {
  height: 92rpx;
  margin-top: 16rpx;
  border-radius: 28rpx;
  background: transparent;
  color: #7c7164;
  font-size: 28rpx;
  font-weight: 800;
}

.btn-plain::after {
  border: none;
}

.relation-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.relation-card.active {
  margin-top: 34rpx;
}

.empty-book-card {
  text-align: center;
}

.empty-book-card .btn-secondary,
.action-card .btn-secondary {
  margin-top: 16rpx;
}

.book-stack {
  display: flex;
  justify-content: center;
  align-items: flex-end;
  gap: 12rpx;
  height: 168rpx;
}

.book-spine {
  width: 58rpx;
  border-radius: 12rpx 12rpx 6rpx 6rpx;
  box-shadow: 0 14rpx 28rpx rgba(64, 43, 25, 0.14);
}

.book-spine.one {
  height: 132rpx;
  background: #5c8f75;
}

.book-spine.two {
  height: 164rpx;
  background: #b85c38;
}

.book-spine.three {
  height: 116rpx;
  background: #d8b27a;
}

.empty-title {
  margin-top: 30rpx;
  color: #2d2822;
  font-size: 38rpx;
  font-weight: 900;
}

.empty-desc {
  margin: 14rpx 0 30rpx;
  color: #7c7164;
  font-size: 27rpx;
  line-height: 1.7;
}

.switch-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  border: 1rpx solid rgba(184, 92, 56, 0.22);
  background: rgba(255, 248, 237, 0.95);
  box-shadow: 0 12rpx 32rpx rgba(69, 47, 26, 0.06);
}

.switch-card--out {
  border-color: rgba(92, 143, 117, 0.28);
}

.switch-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #2d2822;
}

.switch-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6a5c4a;
  line-height: 1.5;
}

.switch-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.switch-btn {
  flex: 1;
  margin: 0;
  min-height: 72rpx;
  line-height: 72rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.switch-btn::after {
  border: none;
}

.switch-btn.reject {
  background: rgba(120, 98, 72, 0.1);
  color: #6a5c4a;
}

.switch-btn.approve {
  background: linear-gradient(135deg, #5c8f75, #477560);
  color: #fff8ed;
}

.reading-card {
  display: flex;
  gap: 28rpx;
  margin-top: 28rpx;
}

.today-panel {
  margin-top: 28rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(120, 98, 72, 0.16);
  border-radius: 40rpx;
  background: rgba(255, 251, 243, 0.92);
  box-shadow: 0 20rpx 54rpx rgba(69, 47, 26, 0.08);
  box-sizing: border-box;
}

.today-duo {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid rgba(120, 98, 72, 0.1);
}

.duo-mini {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  min-width: 88rpx;
}

.duo-mini-name {
  color: #2d2822;
  font-size: 24rpx;
  font-weight: 900;
}

.duo-bridge {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  min-width: 100rpx;
}

.duo-bridge-line {
  width: 100%;
  height: 2rpx;
  background: linear-gradient(90deg, #5c8f75, #d8b27a, #b85c38);
}

.duo-bridge-text {
  color: #a54f33;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.today-body {
  margin-top: 28rpx;
  display: flex;
  gap: 28rpx;
}

.today-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.action-link-dot {
  color: #c8bdb0;
  font-size: 24rpx;
}

.action-links {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.action-link {
  color: #4f7b65;
  font-size: 26rpx;
  font-weight: 900;
}

.action-link-sep {
  color: #c8bdb0;
  font-size: 24rpx;
}


.book-cover {
  width: 178rpx;
  min-height: 238rpx;
  flex-shrink: 0;
  padding: 26rpx 20rpx;
  border-radius: 24rpx 14rpx 14rpx 24rpx;
  background: linear-gradient(160deg, #8f4d35, #c98a5a);
  box-shadow: 16rpx 18rpx 34rpx rgba(73, 45, 24, 0.18);
  box-sizing: border-box;
}

.cover-title {
  color: #fff8ed;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
}

.cover-line {
  width: 48rpx;
  height: 4rpx;
  margin: 24rpx 0;
  border-radius: 999rpx;
  background: rgba(255, 248, 237, 0.65);
}

.cover-author {
  color: rgba(255, 248, 237, 0.8);
  font-size: 20rpx;
  line-height: 1.4;
}

.reading-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.reading-label {
  color: #a54f33;
  font-size: 22rpx;
  font-weight: 900;
}

.reading-main {
  margin-top: 14rpx;
  color: #2d2822;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.35;
}

.reading-note {
  margin-top: 16rpx;
  color: #7c7164;
  font-size: 25rpx;
  line-height: 1.6;
}

.reading-open-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #4f7b65;
}

.progress-panel {
  padding: 32rpx;
}

.progress-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.partner-row {
  margin-top: 28rpx;
}

.progress-meta {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 14rpx;
  color: #2d2822;
  font-size: 26rpx;
  font-weight: 800;
}

.avatar-mini {
  width: 48rpx;
  height: 48rpx;
  font-size: 20rpx;
}

.progress-num {
  color: #7c7164;
  font-size: 24rpx;
  font-weight: 800;
}

.progress-track {
  height: 18rpx;
  margin-top: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(124, 113, 100, 0.14);
}

.progress-fill {
  height: 100%;
  min-width: 20rpx;
  border-radius: 999rpx;
}

.progress-fill.me {
  background: #5c8f75;
}

.progress-fill.partner {
  background: #b85c38;
}

.action-card {
  margin-bottom: 34rpx;
}

.action-title {
  color: #2d2822;
  font-size: 34rpx;
  font-weight: 900;
}

.action-desc {
  margin: 10rpx 0 28rpx;
  color: #7c7164;
  font-size: 26rpx;
  line-height: 1.6;
}

.text-link {
  margin-top: 24rpx;
  color: #7c7164;
  font-size: 26rpx;
  font-weight: 800;
  text-align: center;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  margin-bottom: 42rpx;
}

.form-input {
  min-height: 108rpx;
  padding: 28rpx 30rpx;
  border: 1rpx solid rgba(120, 98, 72, 0.16);
  border-radius: 28rpx;
  background: #fbf7ef;
  color: #2d2822;
  font-size: 30rpx;
  line-height: 44rpx;
  box-sizing: border-box;
}

.modal-submit {
  width: 100%;
}

.book-modal {
  background: #fffbf3;
}

.review-login-modal {
  background: #fffbf3;
}

.review-login-desc {
  margin: -20rpx 0 28rpx;
  color: #7c7164;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.55;
}

.w-full {
  width: 100%;
  box-sizing: border-box;
}

@media (max-width: 360px) {
  .hero-title,
  .page-title {
    font-size: 48rpx;
  }

  .reading-card {
    flex-direction: column;
  }

  .book-cover {
    width: 100%;
    min-height: 196rpx;
  }
}
