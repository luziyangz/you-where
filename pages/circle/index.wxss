.circle-page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  padding: 48rpx 34rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background:
    radial-gradient(circle at 12% 8%, rgba(184, 92, 56, 0.12), transparent 220rpx),
    linear-gradient(180deg, #fbf6ec 0%, #f3eadb 100%);
}

.page-bg,
.page-orb {
  position: absolute;
  pointer-events: none;
}

.page-bg {
  right: -160rpx;
  top: 180rpx;
  width: 480rpx;
  height: 480rpx;
  border-radius: 50%;
  background: rgba(92, 143, 117, 0.1);
}

.page-orb {
  left: -120rpx;
  bottom: 120rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: rgba(184, 92, 56, 0.08);
}

.page-head {
  position: relative;
  z-index: 1;
}

.feed-list,
.empty-panel,
.state-text {
  position: relative;
  z-index: 1;
}

.feed-book-tag {
  color: #4f7b65;
  font-size: 24rpx;
  font-weight: 900;
  flex: 1;
  min-width: 0;
}

.feed-excerpt {
  margin-top: 16rpx;
  color: #2d2822;
  font-size: 32rpx;
  line-height: 1.68;
  font-weight: 500;
}

.list-foot {
  position: relative;
  z-index: 1;
}

.eyebrow {
  display: inline-flex;
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(184, 92, 56, 0.24);
  border-radius: 999rpx;
  background: rgba(255, 251, 243, 0.72);
  color: #a54f33;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.page-title {
  margin-top: 22rpx;
  color: #2d2822;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.18;
}

.page-desc {
  margin-top: 16rpx;
  color: #7c7164;
  font-size: 27rpx;
  line-height: 1.65;
}

.state-text {
  margin-top: 80rpx;
  text-align: center;
  color: #9a8e7e;
  font-size: 28rpx;
}

.empty-panel {
  margin-top: 36rpx;
  padding: 52rpx 36rpx 44rpx;
  border: 1rpx solid rgba(120, 98, 72, 0.14);
  border-radius: 40rpx;
  background: rgba(255, 251, 243, 0.92);
  box-shadow: 0 18rpx 46rpx rgba(69, 47, 26, 0.06);
  text-align: center;
}

.empty-icon {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto;
  border-radius: 24rpx;
  background: linear-gradient(160deg, #8f4d35, #c98a5a);
  box-shadow: 12rpx 14rpx 28rpx rgba(73, 45, 24, 0.16);
}

.empty-title {
  margin-top: 20rpx;
  color: #2d2822;
  font-size: 34rpx;
  font-weight: 900;
}

.empty-desc {
  margin: 16rpx 0 32rpx;
  color: #7c7164;
  font-size: 26rpx;
  line-height: 1.65;
}

.feed-list {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.feed-card {
  padding: 32rpx;
  border-radius: 36rpx;
  border: 1rpx solid rgba(120, 98, 72, 0.14);
  background: rgba(255, 251, 243, 0.94);
  box-shadow: 0 16rpx 40rpx rgba(69, 47, 26, 0.06);
}

.tab-row {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  display: flex;
  gap: 16rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 251, 243, 0.88);
  border: 1rpx solid rgba(120, 98, 72, 0.12);
}

.tab-row .tab-item {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: #7c7164;
  font-size: 26rpx;
  font-weight: 900;
}

.tab-row .tab-item.is-active {
  background: #efe2cf;
  color: #2d2822;
}

.search-row {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.search-input {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(120, 98, 72, 0.16);
  background: rgba(255, 251, 243, 0.92);
  font-size: 26rpx;
  box-sizing: border-box;
}

.search-btn {
  padding: 0 26rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  background: rgba(92, 143, 117, 0.12);
  color: #4f7b65;
  font-size: 26rpx;
  font-weight: 900;
}

.feed-user {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.feed-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.feed-avatar-text {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #5c8f75;
  color: #fff8ed;
  font-size: 26rpx;
  font-weight: 900;
}

.feed-name {
  color: #2d2822;
  font-size: 26rpx;
  font-weight: 900;
}

.explore-book {
  margin-top: 14rpx;
}

.mine-time {
  margin-top: 12rpx;
}

.feed-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.shared-preview {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  padding: 28rpx 30rpx;
  border-radius: 32rpx;
  border: 1rpx solid rgba(92, 143, 117, 0.22);
  background: rgba(92, 143, 117, 0.08);
}

.shared-preview-label {
  color: #4f7b65;
  font-size: 22rpx;
  font-weight: 900;
}

.shared-preview-book {
  margin-top: 12rpx;
  color: #2d2822;
  font-size: 28rpx;
  font-weight: 900;
}

.shared-preview-excerpt {
  margin-top: 14rpx;
  color: #2d2822;
  font-size: 30rpx;
  line-height: 1.65;
}

.shared-preview-from {
  margin-top: 12rpx;
  color: #7c7164;
  font-size: 24rpx;
}

.feed-delete {
  color: #a54f33;
  font-size: 24rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.feed-time {
  margin-top: 12rpx;
  color: #8a7d6e;
  font-size: 22rpx;
}

.feed-actions {
  margin-top: 22rpx;
}

.share-wx-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #5c8f75, #477560);
  color: #fff8ed;
  font-size: 28rpx;
  font-weight: 900;
}

.share-wx-btn::after {
  border: none;
}

.list-foot {
  padding: 28rpx 0 12rpx;
  text-align: center;
  color: #9a8e7e;
  font-size: 24rpx;
}

.list-foot--end {
  color: #b5a896;
}

.comment-textarea {
  width: 100%;
  height: 240rpx;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(120, 98, 72, 0.16);
  background: #fbf7ef;
  box-sizing: border-box;
  font-size: 28rpx;
}

.report-link {
  flex-shrink: 0;
  color: #9a8e7e;
  font-size: 22rpx;
  padding: 4rpx 8rpx;
}

.feed-report-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 8rpx;
}

.shared-preview .report-link {
  margin-top: 10rpx;
  text-align: right;
}

.modal-submit {
  width: 100%;
  margin-top: 28rpx;
}
