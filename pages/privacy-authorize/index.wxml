<view class="wrap">
  <view class="card">
    <view class="title">需要您同意隐私指引</view>
    <view class="desc">
      从聊天记录导入 TXT、复制共读码等能力，需先阅读并同意微信平台要求的 {{contractName}}。
    </view>
    <view class="referrer" wx:if="{{referrer}}">触发来源：{{referrer}}</view>
    <view class="hint" wx:if="{{resumeHint}}">{{resumeHint}}</view>
  </view>

  <view class="foot">
    <button class="btn-contract" plain bindtap="onOpenContract">查看完整隐私指引</button>
    <button
      wx:if="{{supportAgreeBtn}}"
      id="privacy-global-agree-btn"
      class="btn-agree"
      plain
      open-type="agreePrivacyAuthorization"
      bindagreeprivacyauthorization="onAgree"
    >同意并继续</button>
    <button wx:else class="btn-agree" plain bindtap="onTapFallbackAgree">同意并继续</button>
    <button class="btn-refuse" plain bindtap="onDisagree">暂不授权</button>
  </view>
</view>
