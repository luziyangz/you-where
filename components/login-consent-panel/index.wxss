.consent-panel {
  width: 100%;
  margin-bottom: 28rpx;
}

.wx-privacy-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(45, 40, 34, 0.08);
}

.wx-privacy-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2d2822;
  margin-bottom: 12rpx;
}

.wx-privacy-desc {
  font-size: 26rpx;
  color: #6b6157;
  line-height: 1.55;
  margin-bottom: 20rpx;
}

.btn-privacy-contract,
.btn-privacy-agree {
  width: 100%;
  margin: 0 0 16rpx;
  padding: 0;
  box-sizing: border-box;
}

.btn-privacy-contract::after,
.btn-privacy-agree::after {
  border: none;
}

.btn-privacy-contract {
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  color: #4f7b65;
  background: rgba(246, 239, 227, 0.9);
  border-radius: 12rpx;
  border: 1rpx solid rgba(92, 143, 117, 0.25);
}

.btn-privacy-agree {
  margin-bottom: 0;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff8ed;
  background: linear-gradient(135deg, #5c8f75, #477560);
  border-radius: 16rpx;
  box-shadow: 0 12rpx 28rpx rgba(92, 143, 117, 0.22);
}

.terms-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 8rpx 4rpx;
}

.checkbox {
  margin-top: 6rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid #a89884;
  flex-shrink: 0;
  box-sizing: border-box;
}

.checkbox-on {
  border-color: #3d3428;
  background: #3d3428;
  position: relative;
}

.checkbox-on::after {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 6rpx;
  width: 10rpx;
  height: 18rpx;
  border: solid #f6efe3;
  border-width: 0 4rpx 4rpx 0;
  transform: rotate(45deg);
}

.terms-text {
  flex: 1;
  font-size: 26rpx;
  color: #5c5349;
  line-height: 1.55;
}

.terms-text .link {
  color: #4a6fa5;
  text-decoration: underline;
}

.terms-hint {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #b08a6a;
}
