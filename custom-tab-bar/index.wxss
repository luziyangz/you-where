.tab-shell {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  z-index: 100;
  height: 124rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 14rpx;
  border: 1rpx solid rgba(120, 98, 72, 0.18);
  border-radius: 44rpx;
  background: rgba(255, 251, 243, 0.92);
  box-shadow: 0 20rpx 52rpx rgba(69, 47, 26, 0.14);
  backdrop-filter: blur(16px);
  box-sizing: border-box;
}

.tab-item {
  flex: 1;
  height: 94rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  color: #8a7d6e;
  transition: all 0.18s ease;
}

.tab-item.is-active {
  background: #efe2cf;
  color: #2d2822;
  box-shadow: inset 0 0 0 1rpx rgba(120, 98, 72, 0.08);
}

.tab-icon {
  width: 36rpx;
  height: 36rpx;
  background: currentColor;
  opacity: 0.92;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
  mask-repeat: no-repeat;
  mask-position: center;
  mask-size: contain;
}

