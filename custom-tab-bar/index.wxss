.tab-text {
  margin-top: 6rpx;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 0;
  line-height: 1.15;
  text-align: center;
  white-space: nowrap;
  transform: scale(0.96);
}

.tab-center {
  width: 132rpx;
  height: 122rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.center-btn {
  width: 104rpx;
  height: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 8rpx solid #fffbf3;
  border-radius: 50%;
  background: linear-gradient(160deg, #b85c38, #8f4d35);
  color: #fff8ed;
  box-shadow: 0 18rpx 38rpx rgba(184, 92, 56, 0.28);
  box-sizing: border-box;
}

.center-icon {
  width: 44rpx;
  height: 44rpx;
  background: currentColor;
