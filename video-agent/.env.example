APP_NAME=video-agent
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000

STORAGE_ROOT=./storage
UPLOAD_MAX_MB=500
VIDEO_MAX_SECONDS=600

FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
FFMPEG_TIMEOUT_SECONDS=300

WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16
WHISPER_LANGUAGE=zh

SCENE_DETECT_THRESHOLD=27.0
KEYFRAMES_PER_SHOT=3

OCR_ENABLED=false
VISION_ENABLED=false
VISION_PROVIDER=mock

API_AUTH_ENABLED=false
API_KEY=change-me
