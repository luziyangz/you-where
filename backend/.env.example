DB_BACKEND=mysql

MYSQL_ROOT_PASSWORD=replace_with_a_strong_root_password
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=you_where
MYSQL_PASSWORD=replace_with_a_strong_app_password
MYSQL_DB=you_where
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20

HTTP_PORT=80
HTTPS_PORT=443
SERVER_DOMAIN=www.nizaina.online
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

WECHAT_APP_ID=wx401cfbd2f9e9c978
WECHAT_APP_SECRET=replace_with_wechat_app_secret
WECHAT_REMINDER_TEMPLATE_ID=

# 1=书城翻页同步 Gutendex；国内机 curl gutendex.com 若长期超时请设 0
STORE_ENABLE_NETWORK=0
# Gutendex HTTP 超时（秒），国内链路慢建议 20+
GUTENDEX_FETCH_TIMEOUT=20
# Gutendex 中文书目批量同步最多拉取页数（每页约 32 本）
GUTENDEX_ZH_SYNC_MAX_PAGES=30
# 部署时预取 Gutenberg 公版全书到数据库（首次较慢，之后跳过已缓存）
STORE_PREFETCH_CONTENT=1
ENABLE_TEST_USERS=0
SEED_TEST_USERS=0
ENABLE_REVIEW_LOGIN=0
WECHAT_REVIEW_ACCOUNT=reviewer
WECHAT_REVIEW_PASSWORD=replace_with_review_password

# 仅测试库可设为 1，允许迁移脚本/清空书城等破坏性操作（生产禁止）
# ALLOW_DESTRUCTIVE_DB=0
